Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", 
    RowBox[{"Protocol", ":", 
     RowBox[{"Data", " ", "Confrontation", " ", "Suite"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauRelax", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Galactic", " ", "Rotation", " ", "Confrontation", " ", 
     RowBox[{"(", 
      RowBox[{"Milky", " ", "Way", " ", "Proxy"}], ")"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Parameters", ":", 
      RowBox[{"r", " ", 
       RowBox[{"(", "kpc", ")"}]}]}], ",", 
     RowBox[{"vObs", " ", 
      RowBox[{"(", 
       RowBox[{"km", "/", "s"}], ")"}]}], ",", 
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{"Baryonic", " ", "scale"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vGrover", "[", 
      RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
     RowBox[{"220", "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{"r", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], "*", 
             RowBox[{"s", "/", 
              RowBox[{"r", "^", "3"}]}]}], "+", 
            RowBox[{"R", "/", 
             RowBox[{"(", 
              RowBox[{"r", "+", "s"}], ")"}]}]}], ")"}]}]}], "]"}], "]"}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"dataMW", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"5", ",", "215"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", "225"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"15", ",", "230"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"20", ",", "228"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"25", ",", "225"}], "}"}]}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Sample", " ", "SPARC"}], "-", 
     RowBox[{"like", " ", "data"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"dataMW", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"White", ",", 
            RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Milky Way Rotation Fit\>\""}]}], 
        "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"vGrover", "[", 
          RowBox[{"r", ",", "1.2"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "1", ",", "30"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Orange", ",", 
            RowBox[{"Thickness", "[", "0.008", "]"}]}], "}"}]}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Cluster", " ", "Aging", " ", "Confrontation", " ", 
     RowBox[{"(", 
      RowBox[{"Bullet", " ", "Cluster", " ", 
       RowBox[{"vs", ".", "Relaxed"}], " ", "Cluster"}], ")"}]}], "*)"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"fDM", 
      RowBox[{"(", "t", ")"}]}], "=", 
     RowBox[{"f0", "*", "exp", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "tau"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fDM", "[", "t_", "]"}], ":=", 
     RowBox[{"14", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "tauRelax"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"clusterData", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.5", ",", "13.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"13.8", ",", "7.0"}], "}"}]}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Age", " ", "Gyr"}], ",", 
      RowBox[{"Observed", " ", "fDM"}]}], "}"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"agePlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"clusterData", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Cyan", ",", 
            RowBox[{"PointSize", "[", "0.03", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabels", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Bullet Cluster (Young)\>\"", 
            ",", "\"\<Local Cluster (Old)\>\""}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"fDM", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "15"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Dashed"}], "}"}]}]}], "]"}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{"fitPlot", ",", "agePlot"}], "}"}], "]"}], "]"}], 
    ";"}]}]}]], "Input",
