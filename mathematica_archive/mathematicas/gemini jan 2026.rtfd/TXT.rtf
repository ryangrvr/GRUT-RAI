\f7\fs21 \AppleTypeServices \cf12 \cb7 \strokec12 import\cf5 \strokec5  numpy \cf12 \strokec12 as\cf5 \strokec5  np\
\cf12 \strokec12 import\cf5 \strokec5  uuid\
\cf12 \strokec12 from\cf5 \strokec5  fastapi \cf12 \strokec12 import\cf5 \strokec5  APIRouter, HTTPException\
\cf12 \strokec12 from\cf5 \strokec5  core.data_adapter \cf12 \strokec12 import\cf5 \strokec5  RealDataAdapter\
\cf12 \strokec12 from\cf5 \strokec5  core.schemas \cf12 \strokec12 import\cf5 \strokec5  Fsigma8TauSearchRequest, Fsigma8TauSearchResponse\
\cf12 \strokec12 from\cf5 \strokec5  core.anamnesis \cf12 \strokec12 import\cf5 \strokec5  AnamnesisSolver \cf15 \strokec15 # Assuming existing solver import\cf5 \strokec5 \
\
router = APIRouter()\
\
\cf16 \strokec16 @router.post(\cf11 \strokec11 "/search_tau_fsigma8"\cf16 \strokec16 , response_model=Fsigma8TauSearchResponse)\cf5 \strokec5 \
\cf12 \strokec12 async\cf5 \strokec5  \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 search_tau_fsigma8\cf5 \strokec5 (request: Fsigma8TauSearchRequest):\
    \cf11 \strokec11 """\
    Instrument Endpoint: Tests GRUT memory hypothesis against real fsigma8 data.\
    1. Adapts Redshift (z) -> Lookback Time (t) via standard LCDM.\
    2. Resamples to uniform time grid.\
    3. Runs Anamnesis Search for optimal Tau.\
    """\cf5 \strokec5 \
    \
    \cf15 \strokec15 # 1. Validation\cf5 \strokec5 \
    \cf12 \strokec12 if\cf5 \strokec5  \cf16 \strokec16 len\cf5 \strokec5 (request.data.z) != \cf16 \strokec16 len\cf5 \strokec5 (request.data.fsigma8):\
        \cf12 \strokec12 raise\cf5 \strokec5  HTTPException(status_code=\cf14 \strokec14 400\cf5 \strokec5 , detail=\cf11 \strokec11 "Mismatch in z and fsigma8 array lengths."\cf5 \strokec5 )\
    \
    z_arr = np.array(request.data.z)\
    y_arr = np.array(request.data.fsigma8)\
    sigma_arr = np.array(request.data.sigma) \cf12 \strokec12 if\cf5 \strokec5  request.data.sigma \cf12 \strokec12 else\cf5 \strokec5  \cf14 \strokec14 None\cf5 \strokec5 \
    \
    \cf15 \strokec15 # 2. Adapter: Transform z -> t\cf5 \strokec5 \
    adapter = RealDataAdapter(h0=request.data.cosmo.H0, omega_m=request.data.cosmo.Omega_m)\
    \
    \cf15 \strokec15 # Compute Lookback Time (Gyr)\cf5 \strokec5 \
    t_gyr_raw = adapter.compute_lookback_time_gyr(z_arr)\
    \
    \cf15 \strokec15 # Resample to Uniform Grid for Kernel\cf5 \strokec5 \
    t_uniform, y_uniform, sigma_uniform = adapter.resample_uniform(\
        t_gyr_raw, y_arr, sigma_arr, dt_myr=request.dt_myr\
    )\
    \
    \cf15 \strokec15 # 3. Unit Conversion for Kernel (Gyr -> Seconds)\cf5 \strokec5 \
    \cf15 \strokec15 # 1 Gyr = 3.1536e16 seconds (approx)\cf5 \strokec5 \
    GYR_TO_SEC = \cf14 \strokec14 3.1536e16\cf5 \strokec5  \
    MYR_TO_SEC = \cf14 \strokec14 3.1536e13\cf5 \strokec5 \
    \
    dt_seconds = (request.dt_myr / \cf14 \strokec14 1000.0\cf5 \strokec5 ) * GYR_TO_SEC\
    \
    \cf15 \strokec15 # Convert tau candidates from Myr to Seconds for the engine\cf5 \strokec5 \
    tau_candidates_sec = [t * MYR_TO_SEC \cf12 \strokec12 for\cf5 \strokec5  t \cf12 \strokec12 in\cf5 \strokec5  request.tau_candidates_myr]\
    \
    \cf15 \strokec15 # Ensure Baseline (Tau=0) is tested\cf5 \strokec5 \
    \cf12 \strokec12 if\cf5 \strokec5  \cf14 \strokec14 0.0\cf5 \strokec5  \cf12 \strokec12 not\cf5 \strokec5  \cf12 \strokec12 in\cf5 \strokec5  tau_candidates_sec:\
        \cf15 \strokec15 # Note: Solver handles tau near 0 as Identity/No-Memory\cf5 \strokec5 \
        tau_candidates_sec.insert(\cf14 \strokec14 0\cf5 \strokec5 , \cf14 \strokec14 0.0\cf5 \strokec5 )\
\
    \cf15 \strokec15 # 4. Run Solver (Reuse existing instrument logic)\cf5 \strokec5 \
    \cf15 \strokec15 # Assuming search_tau interface: (signal, dt, tau_grid, lambda, ...)\cf5 \strokec5 \
    results = AnamnesisSolver.search_tau(\
        signal=y_uniform, \
        dt=dt_seconds,\
        tau_grid=tau_candidates_sec,\
        lam=request.lam,\
        max_iter=request.max_iter,\
        tol=request.tol,\
        nonnegative=request.nonnegative\
    )\
    \
    \cf15 \strokec15 # 5. Scoring & Baseline Comparison\cf5 \strokec5 \
    \cf15 \strokec15 # Map best result back to Myr\cf5 \strokec5 \
    best_tau_sec = results[\cf11 \strokec11 'best_tau'\cf5 \strokec5 ]\
    best_tau_myr = best_tau_sec / MYR_TO_SEC\
    \
    \cf15 \strokec15 # Extract baseline score (tau ~ 0)\cf5 \strokec5 \
    baseline_score = results[\cf11 \strokec11 'scores'\cf5 \strokec5 ].get(\cf14 \strokec14 0.0\cf5 \strokec5 , \cf16 \strokec16 float\cf5 \strokec5 (\cf11 \strokec11 'inf'\cf5 \strokec5 ))\
    \
    \cf15 \strokec15 # Compute Chi2 / AIC if errors provided\cf5 \strokec5 \
    \cf15 \strokec15 # (Simple weighted Euclidean if sigma exists, else standard reconstruction error)\cf5 \strokec5 \
    final_stats = \{\
        \cf11 \strokec11 "ris_value"\cf5 \strokec5 : results[\cf11 \strokec11 'best_score'\cf5 \strokec5 ],\
        \cf11 \strokec11 "chi2"\cf5 \strokec5 : -\cf14 \strokec14 1.0\cf5 \strokec5 , \
        \cf11 \strokec11 "aic"\cf5 \strokec5 : -\cf14 \strokec14 1.0\cf5 \strokec5 \
    \}\
    \
    \cf12 \strokec12 if\cf5 \strokec5  sigma_uniform \cf12 \strokec12 is\cf5 \strokec5  \cf12 \strokec12 not\cf5 \strokec5  \cf14 \strokec14 None\cf5 \strokec5 :\
        \cf15 \strokec15 # Reconstruct signal using best tau\cf5 \strokec5 \
        reconstructed = AnamnesisSolver.reconstruct(y_uniform, dt_seconds, best_tau_sec)\
        \cf15 \strokec15 # Chi2 = sum( (obs - model)^2 / sigma^2 )\cf5 \strokec5 \
        chi2 = np.\cf16 \strokec16 sum\cf5 \strokec5 (((y_uniform - reconstructed)**\cf14 \strokec14 2\cf5 \strokec5 ) / (sigma_uniform**\cf14 \strokec14 2\cf5 \strokec5 ))\
        k = \cf14 \strokec14 1\cf5 \strokec5  \cf15 \strokec15 # 1 parameter: tau\cf5 \strokec5 \
        n = \cf16 \strokec16 len\cf5 \strokec5 (y_uniform)\
        aic = chi2 + \cf14 \strokec14 2\cf5 \strokec5 *k + (\cf14 \strokec14 2\cf5 \strokec5 *k*(k+\cf14 \strokec14 1\cf5 \strokec5 ))/(n-k-\cf14 \strokec14 1\cf5 \strokec5 )\
        \
        final_stats[\cf11 \strokec11 'chi2'\cf5 \strokec5 ] = chi2\
        final_stats[\cf11 \strokec11 'aic'\cf5 \strokec5 ] = aic\
\
    \cf15 \strokec15 # 6. Construct Response\cf5 \strokec5 \
    diagnostic = \{\
        \cf11 \strokec11 "dataset_label"\cf5 \strokec5 : request.data.dataset_label,\
        \cf11 \strokec11 "n_raw"\cf5 \strokec5 : \cf16 \strokec16 len\cf5 \strokec5 (z_arr),\
        \cf11 \strokec11 "n_resampled"\cf5 \strokec5 : \cf16 \strokec16 len\cf5 \strokec5 (t_uniform),\
        \cf11 \strokec11 "t_lookback_max_gyr"\cf5 \strokec5 : \cf16 \strokec16 float\cf5 \strokec5 (np.\cf16 \strokec16 max\cf5 \strokec5 (t_uniform)),\
        \cf11 \strokec11 "dt_used_myr"\cf5 \strokec5 : request.dt_myr,\
        \cf11 \strokec11 "cosmo_h0"\cf5 \strokec5 : request.data.cosmo.H0\
    \}\
    \
    \cf15 \strokec15 # Format scores dictionary keys back to Myr for readability\cf5 \strokec5 \
    scores_myr = \{k / MYR_TO_SEC: v \cf12 \strokec12 for\cf5 \strokec5  k, v \cf12 \strokec12 in\cf5 \strokec5  results[\cf11 \strokec11 'scores'\cf5 \strokec5 ].items()\}\
\
    \cf12 \strokec12 return\cf5 \strokec5  Fsigma8TauSearchResponse(\
        best_tau_myr=best_tau_myr,\
        best_score=results[\cf11 \strokec11 'best_score'\cf5 \strokec5 ],\
        baseline_comparison=\{\cf11 \strokec11 "delta_vs_baseline"\cf5 \strokec5 : baseline_score - results[\cf11 \strokec11 'best_score'\cf5 \strokec5 ]\},\
        scores=scores_myr,\
        reconstruction_stats=final_stats,\
        adapter_diagnostic=diagnostic,\
        run_id=\cf16 \strokec16 str\cf5 \strokec5 (uuid.uuid4())\
    )\
