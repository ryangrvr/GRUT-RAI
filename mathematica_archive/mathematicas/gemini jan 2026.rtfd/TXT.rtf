\f7\fs21 \AppleTypeServices \cf12 \cb7 \strokec12 import\cf5 \strokec5  numpy \cf12 \strokec12 as\cf5 \strokec5  np\
\cf12 \strokec12 from\cf5 \strokec5  typing \cf12 \strokec12 import\cf5 \strokec5  Tuple, Optional\
\
\cf12 \strokec12 class\cf13 \strokec13  RealDataAdapter:\cf5 \strokec5 \
    \cf11 \strokec11 """\
    Instrument-grade adapter for transforming Redshift (z) to Lookback Time (t).\
    Uses standard LCDM cosmology and pure NumPy for integration/resampling.\
    Strictly separates observation coordinates from time-domain convolution logic.\
    """\cf5 \strokec5 \
    \
    \cf15 \strokec15 # Constants\cf5 \strokec5 \
    KM_M_MPC = \cf14 \strokec14 3.08567758e19\cf5 \strokec5   \cf15 \strokec15 # km to Mpc conversion is not direct, usually H0 is km/s/Mpc\cf5 \strokec5 \
    \cf15 \strokec15 # 1 Mpc = 3.0857e19 km. H0 units are (km/s) / Mpc. \cf5 \strokec5 \
    \cf15 \strokec15 # To get 1/time: (km/s) / km * (km/Mpc?) No.\cf5 \strokec5 \
    \cf15 \strokec15 # H0 = 100 * h km/s/Mpc.\cf5 \strokec5 \
    \cf15 \strokec15 # 1 Mpc = 3.08567758e22 m = 3.08567758e19 km\cf5 \strokec5 \
    \cf15 \strokec15 # H0 [1/s] = H0 [km/s/Mpc] / (3.08567758e19 [km/Mpc])\cf5 \strokec5 \
    \cf15 \strokec15 # 1 Gyr in seconds = 3.1536e16 s\cf5 \strokec5 \
    \
    \cf15 \strokec15 # Simple conversion: 1/H0 [Gyr] = 977.8 / H0_km_s_Mpc\cf5 \strokec5 \
    \cf15 \strokec15 # e.g. if H0=67.4, 1/H0 ~ 14.5 Gyr. \cf5 \strokec5 \
    \
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 __init__\cf5 \strokec5 (self, h0: \cf16 \strokec16 float\cf5 \strokec5  = \cf14 \strokec14 67.4\cf5 \strokec5 , omega_m: \cf16 \strokec16 float\cf5 \strokec5  = \cf14 \strokec14 0.315\cf5 \strokec5 ):\
        \cf11 \strokec11 """\
        :param h0: Hubble constant in km/s/Mpc (default Planck 2018: ~67.4)\
        :param omega_m: Matter density parameter (default Planck 2018: ~0.315)\
        """\cf5 \strokec5 \
        self.H0 = h0\
        self.Om = omega_m\
        self.Ol = \cf14 \strokec14 1.0\cf5 \strokec5  - omega_m  \cf15 \strokec15 # Flat universe assumption\cf5 \strokec5 \
        \
        \cf15 \strokec15 # Hubble time in Gigayears\cf5 \strokec5 \
        \cf15 \strokec15 # t_H = 1/H0. Conversion factor: 100 km/s/Mpc -> 9.778 Gyr\cf5 \strokec5 \
        \cf15 \strokec15 # So t_H [Gyr] = 977.8 / h0\cf5 \strokec5 \
        self.thub_gyr = \cf14 \strokec14 977.79222\cf5 \strokec5  / self.H0 \
\
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 ez_inverse_integral\cf5 \strokec5 (self, z: \cf16 \strokec16 float\cf5 \strokec5 ) -> float:\
        \cf11 \strokec11 """\
        Computes 1 / ((1+z) * E(z)) for the lookback time integrand.\
        """\cf5 \strokec5 \
        Ez = np.sqrt(self.Om * (\cf14 \strokec14 1\cf5 \strokec5  + z)**\cf14 \strokec14 3\cf5 \strokec5  + self.Ol)\
        \cf12 \strokec12 return\cf5 \strokec5  \cf14 \strokec14 1.0\cf5 \strokec5  / ((\cf14 \strokec14 1\cf5 \strokec5  + z) * Ez)\
\
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 compute_lookback_time_gyr\cf5 \strokec5 (self, z_arr: np.ndarray, integration_steps: \cf16 \strokec16 int\cf5 \strokec5  = \cf14 \strokec14 1000\cf5 \strokec5 ) -> np.ndarray:\
        \cf11 \strokec11 """\
        Maps an array of redshifts to Lookback Time (Gyr) using trapezoidal integration.\
        Uses a dense internal grid for accuracy, then interpolates to z_arr points.\
        """\cf5 \strokec5 \
        z_max = np.\cf16 \strokec16 max\cf5 \strokec5 (z_arr)\
        \cf15 \strokec15 # Create dense grid for integration accuracy (0 to max observed z)\cf5 \strokec5 \
        z_grid = np.linspace(\cf14 \strokec14 0\cf5 \strokec5 , z_max * \cf14 \strokec14 1.05\cf5 \strokec5 , integration_steps)\
        \
        \cf15 \strokec15 # Calculate integrand on grid\cf5 \strokec5 \
        integrand = np.array([self.ez_inverse_integral(z) \cf12 \strokec12 for\cf5 \strokec5  z \cf12 \strokec12 in\cf5 \strokec5  z_grid])\
        \
        \cf15 \strokec15 # Cumulative integral (Trapezoidal rule)\cf5 \strokec5 \
        \cf15 \strokec15 # t_L(z) = t_H * integral_0^z ...\cf5 \strokec5 \
        integral_cum = np.zeros_like(z_grid)\
        integral_cum[\cf14 \strokec14 1\cf5 \strokec5 :] = np.cumsum(\cf14 \strokec14 0.5\cf5 \strokec5  * (z_grid[\cf14 \strokec14 1\cf5 \strokec5 :] - z_grid[:-\cf14 \strokec14 1\cf5 \strokec5 ]) * (integrand[\cf14 \strokec14 1\cf5 \strokec5 :] + integrand[:-\cf14 \strokec14 1\cf5 \strokec5 ]))\
        \
        t_grid_gyr = self.thub_gyr * integral_cum\
        \
        \cf15 \strokec15 # Interpolate the specific input z points onto this calculated curve\cf5 \strokec5 \
        \cf15 \strokec15 # z_arr must be mapped to the time grid\cf5 \strokec5 \
        t_targets = np.interp(z_arr, z_grid, t_grid_gyr)\
        \
        \cf12 \strokec12 return\cf5 \strokec5  t_targets\
\
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 resample_uniform\cf5 \strokec5 (self, \
                         t_gyr: np.ndarray, \
                         y_data: np.ndarray, \
                         sigma_data: Optional[np.ndarray] = \cf14 \strokec14 None\cf5 \strokec5 ,\
                         dt_myr: \cf16 \strokec16 float\cf5 \strokec5  = \cf14 \strokec14 5.0\cf5 \strokec5 ) -> Tuple[np.ndarray, np.ndarray, Optional[np.ndarray]]:\
        \cf11 \strokec11 """\
        Resamples non-uniform (t, y) data onto a uniform grid for convolution.\
        \
        :param dt_myr: Desired timestep in Million Years\
        """\cf5 \strokec5 \
        dt_gyr = dt_myr / \cf14 \strokec14 1000.0\cf5 \strokec5 \
        \
        \cf15 \strokec15 # Check sort order: Lookback time implies 0 is "now". \cf5 \strokec5 \
        \cf15 \strokec15 # Usually data is sorted by z (asc), which means Lookback Time (asc).\cf5 \strokec5 \
        \cf15 \strokec15 # We need strict monotonicity for interpolation.\cf5 \strokec5 \
        \
        \cf15 \strokec15 # Sort just in case\cf5 \strokec5 \
        sort_idx = np.argsort(t_gyr)\
        t_sorted = t_gyr[sort_idx]\
        y_sorted = y_data[sort_idx]\
        sigma_sorted = sigma_data[sort_idx] \cf12 \strokec12 if\cf5 \strokec5  sigma_data \cf12 \strokec12 is\cf5 \strokec5  \cf12 \strokec12 not\cf5 \strokec5  \cf14 \strokec14 None\cf5 \strokec5  \cf12 \strokec12 else\cf5 \strokec5  \cf14 \strokec14 None\cf5 \strokec5 \
        \
        \cf15 \strokec15 # Create uniform grid\cf5 \strokec5 \
        \cf15 \strokec15 # Start at min time, end at max time\cf5 \strokec5 \
        t_min, t_max = t_sorted[\cf14 \strokec14 0\cf5 \strokec5 ], t_sorted[-\cf14 \strokec14 1\cf5 \strokec5 ]\
        \
        \cf15 \strokec15 # Ensure grid covers the range\cf5 \strokec5 \
        num_steps = \cf16 \strokec16 int\cf5 \strokec5 (np.ceil((t_max - t_min) / dt_gyr))\
        t_uniform = np.linspace(t_min, t_min + num_steps * dt_gyr, num_steps + \cf14 \strokec14 1\cf5 \strokec5 )\
        \
        \cf15 \strokec15 # Linear Interpolation\cf5 \strokec5 \
        y_uniform = np.interp(t_uniform, t_sorted, y_sorted)\
        \
        \cf15 \strokec15 # Interpolate error if present (simple linear approximation for weights)\cf5 \strokec5 \
        sigma_uniform = \cf14 \strokec14 None\cf5 \strokec5 \
        \cf12 \strokec12 if\cf5 \strokec5  sigma_sorted \cf12 \strokec12 is\cf5 \strokec5  \cf12 \strokec12 not\cf5 \strokec5  \cf14 \strokec14 None\cf5 \strokec5 :\
            sigma_uniform = np.interp(t_uniform, t_sorted, sigma_sorted)\
            \
        \cf12 \strokec12 return\cf5 \strokec5  t_uniform, y_uniform, sigma_uniform\
