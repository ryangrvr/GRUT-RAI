        err = \cf16 \strokec16 abs\cf5 \strokec5 (best_config[\cf11 \strokec11 "R_obs"\cf5 \strokec5 ] - meta[\cf11 \strokec11 "val"\cf5 \strokec5 ]) / meta[\cf11 \strokec11 "val"\cf5 \strokec5 ]\
