    plt.plot(t, y, label=\cf11 \strokec11 "fsigma8 Signal (y)"\cf5 \strokec5 )\
    plt.plot(k_t, kernel_norm * \cf14 \strokec14 10\cf5 \strokec5 , label=\cf11 \strokec11 "Seth Kernel (Normalized x10 for scale)"\cf5 \strokec5 )\
    plt.title(\cf11 \strokec11 "Visual Alignment Check: Kernel vs. Signal"\cf5 \strokec5 )\
    plt.legend()\
