\cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 diagnostic_plot\cf5 \strokec5 ():\
    \cf15 \strokec15 # 1. Simulate your resampled data\cf5 \strokec5 \
    t = np.linspace(\cf14 \strokec14 0\cf5 \strokec5 , \cf14 \strokec14 5500\cf5 \strokec5 , \cf14 \strokec14 560\cf5 \strokec5 ) \cf15 \strokec15 # 5.6 Gyr at 10 Myr steps\cf5 \strokec5 \
    y = \cf14 \strokec14 0.52\cf5 \strokec5  * np.exp(-\cf14 \strokec14 0.1\cf5 \strokec5  * t/\cf14 \strokec14 1000\cf5 \strokec5 ) \cf15 \strokec15 # Smooth decay like fsigma8\cf5 \strokec5 \
    \
