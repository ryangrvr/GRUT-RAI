            formula=meta[\cf11 \strokec11 "form"\cf5 \strokec5 ],\
            theoretical_value=meta[\cf11 \strokec11 "val"\cf5 \strokec5 ],\
            observed_value=best_config[\cf11 \strokec11 "R_obs"\cf5 \strokec5 ],\
            relative_error=err\
        ))\
\
    \cf15 \strokec15 # 4. Theoretical Prediction (Inversion)\cf5 \strokec5 \
    \cf15 \strokec15 # What is the EXACT Tau predicted by Loop 2?\cf5 \strokec5 \
    \cf15 \strokec15 # Use best H0/Omega from sweep to define rho_L background\cf5 \strokec5 \
    H0_best_si = best_config[\cf11 \strokec11 "H0"\cf5 \strokec5 ] * \cf14 \strokec14 1000\cf5 \strokec5  / \cf14 \strokec14 3.08567758e22\cf5 \strokec5 \
    rho_crit_best = (\cf14 \strokec14 3\cf5 \strokec5  * H0_best_si**\cf14 \strokec14 2\cf5 \strokec5 ) / (\cf14 \strokec14 8\cf5 \strokec5  * CONSTANTS[\cf11 \strokec11 "pi"\cf5 \strokec5 ] * CONSTANTS[\cf11 \strokec11 "G"\cf5 \strokec5 ])\
    rho_L_best = best_config[\cf11 \strokec11 "Omega_L"\cf5 \strokec5 ] * rho_crit_best\
