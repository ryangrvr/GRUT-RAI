\f7\fs21 \AppleTypeServices \cf12 \cb7 \strokec12 import\cf5 \strokec5  numpy \cf12 \strokec12 as\cf5 \strokec5  np\
\cf12 \strokec12 from\cf5 \strokec5  scipy.interpolate \cf12 \strokec12 import\cf5 \strokec5  CubicSpline\
\cf12 \strokec12 from\cf5 \strokec5  scipy.integrate \cf12 \strokec12 import\cf5 \strokec5  quad\
\
\cf12 \strokec12 class\cf13 \strokec13  RealDataAdapter:\cf5 \strokec5 \
    \cf11 \strokec11 """\
    The Bridge: Maps observational Redshift (z) to Lookback Time (t) \
    and resamples onto a uniform grid for S.E.T.H. Kernel convolution.\
    """\cf5 \strokec5 \
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 __init__\cf5 \strokec5 (self, omega_m=\cf14 \strokec14 0.315\cf5 \strokec5 , h=\cf14 \strokec14 0.674\cf5 \strokec5 ):\
        self.omega_m = omega_m\
        self.omega_lambda = \cf14 \strokec14 1.0\cf5 \strokec5  - omega_m\
        self.h = h\
        self.thub = \cf14 \strokec14 9.778\cf5 \strokec5  / h  \cf15 \strokec15 # Hubble time in Gyr\cf5 \strokec5 \
\
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 _h_inv\cf5 \strokec5 (self, z):\
        \cf11 \strokec11 """Standard E(z)^-1 for lookback time integration."""\cf5 \strokec5 \
        \cf12 \strokec12 return\cf5 \strokec5  \cf14 \strokec14 1.0\cf5 \strokec5  / np.sqrt(self.omega_m * (\cf14 \strokec14 1\cf5 \strokec5 +z)**\cf14 \strokec14 3\cf5 \strokec5  + self.omega_lambda)\
\
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 z_to_lookback_time\cf5 \strokec5 (self, z):\
        \cf11 \strokec11 """Integrates redshift to find Lookback Time in Gigayears."""\cf5 \strokec5 \
        itgrl, _ = quad(self._h_inv, \cf14 \strokec14 0\cf5 \strokec5 , z)\
        \cf12 \strokec12 return\cf5 \strokec5  self.thub * itgrl\
\
    \cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 prepare_fsigma8_series\cf5 \strokec5 (self, z_points, data_points, dt=\cf14 \strokec14 0.05\cf5 \strokec5 ):\
        \cf11 \strokec11 """\
        Takes raw f*sigma8 points, transforms to time domain, \
        and resamples to a uniform dt grid.\
        """\cf5 \strokec5 \
        \cf15 \strokec15 # 1. Map z to Time\cf5 \strokec5 \
        t_points = np.array([self.z_to_lookback_time(z) \cf12 \strokec12 for\cf5 \strokec5  z \cf12 \strokec12 in\cf5 \strokec5  z_points])\
        \
        \cf15 \strokec15 # 2. Sort by time (Time increases as z increases)\cf5 \strokec5 \
        sort_idx = np.argsort(t_points)\
        t_sorted = t_points[sort_idx]\
        d_sorted = data_points[sort_idx]\
\
        \cf15 \strokec15 # 3. Create Uniform Grid (The Kernel requires constant dt)\cf5 \strokec5 \
        t_grid = np.arange(t_sorted.\cf16 \strokec16 min\cf5 \strokec5 (), t_sorted.\cf16 \strokec16 max\cf5 \strokec5 (), dt)\
        \
        \cf15 \strokec15 # 4. Spline Interpolation (The 'Smoothing' pass)\cf5 \strokec5 \
        cs = CubicSpline(t_sorted, d_sorted)\
        d_grid = cs(t_grid)\
\
        \cf12 \strokec12 return\cf5 \strokec5  t_grid, d_grid\
\
