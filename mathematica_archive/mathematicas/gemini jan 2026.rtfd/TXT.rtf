\
    \cf15 \strokec15 # 3. Final Evaluation (at Best Config)\cf5 \strokec5 \
    \cf15 \strokec15 # We report Loop 1 vs Loop 2 performance at the optimal coordinates\cf5 \strokec5 \
    final_candidates = []\
