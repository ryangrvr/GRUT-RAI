    print(\cf11 \strokec11 f"Signal Max: \cf2 \cb7 \strokec2 \{np.\cf16 \cb7 \strokec16 max\cf2 \cb7 \strokec2 (y)\}\cf11 \cb7 \strokec11 "\cf5 \strokec5 )\
    print(\cf11 \strokec11 f"Kernel Sum (Unnormalized): \cf2 \cb7 \strokec2 \{np.\cf16 \cb7 \strokec16 sum\cf2 \cb7 \strokec2 (kernel)\}\cf11 \cb7 \strokec11 "\cf5 \strokec5 )\
    print(\cf11 \strokec11 f"Kernel Sum (Normalized): \cf2 \cb7 \strokec2 \{np.\cf16 \cb7 \strokec16 sum\cf2 \cb7 \strokec2 (kernel_norm)\}\cf11 \cb7 \strokec11 "\cf5 \strokec5 )\
