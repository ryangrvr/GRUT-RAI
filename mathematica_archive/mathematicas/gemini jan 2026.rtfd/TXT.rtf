\f7\fs21 \AppleTypeServices \cf12 \cb7 \strokec12 import\cf5 \strokec5  numpy \cf12 \strokec12 as\cf5 \strokec5  np\
\cf12 \strokec12 import\cf5 \strokec5  matplotlib.pyplot \cf12 \strokec12 as\cf5 \strokec5  plt\
