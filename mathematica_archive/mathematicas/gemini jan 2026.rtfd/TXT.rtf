    tau_theory_s = \cf14 \strokec14 1.0\cf5 \strokec5  / np.sqrt(\cf14 \strokec14 8\cf5 \strokec5  * CONSTANTS[\cf11 \strokec11 "pi"\cf5 \strokec5 ] * CONSTANTS[\cf11 \strokec11 "G"\cf5 \strokec5 ] * rho_req_theory)\
    tau_theory_myr = tau_theory_s / CONSTANTS[\cf11 \strokec11 "Myr_to_sec"\cf5 \strokec5 ]\
