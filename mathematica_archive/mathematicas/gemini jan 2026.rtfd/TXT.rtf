\f7\fs21 \AppleTypeServices \cf12 \cb7 \strokec12 import\cf5 \strokec5  numpy \cf12 \strokec12 as\cf5 \strokec5  np\
\cf12 \strokec12 import\cf5 \strokec5  uuid\
\cf12 \strokec12 from\cf5 \strokec5  datetime \cf12 \strokec12 import\cf5 \strokec5  datetime\
\cf12 \strokec12 from\cf5 \strokec5  app.schemas \cf12 \strokec12 import\cf5 \strokec5  CasimirEvidencePacket, CandidateResult, SweepPoint\
\
\cf15 \strokec15 # --- SOVEREIGN CONSTANTS ---\cf5 \strokec5 \
CONSTANTS = \{\
    \cf11 \strokec11 "G"\cf5 \strokec5 : \cf14 \strokec14 6.67430e-11\cf5 \strokec5 ,\
    \cf11 \strokec11 "pi"\cf5 \strokec5 : np.pi,\
    \cf11 \strokec11 "alpha_inv"\cf5 \strokec5 : \cf14 \strokec14 137.035999\cf5 \strokec5 ,\
    \cf11 \strokec11 "Myr_to_sec"\cf5 \strokec5 : \cf14 \strokec14 3.15576e13\cf5 \strokec5 \
\}\
\
\cf12 \strokec12 def\cf5 \strokec5  \cf13 \strokec13 run_casimir_sweep_logic\cf5 \strokec5 (params) -> CasimirEvidencePacket:\
    run_id = \cf16 \strokec16 str\cf5 \strokec5 (uuid.uuid4())\
    \
    \cf15 \strokec15 # 1. Define Candidate Models (Pre-registered)\cf5 \strokec5 \
    alpha = \cf14 \strokec14 1.0\cf5 \strokec5  / CONSTANTS[\cf11 \strokec11 "alpha_inv"\cf5 \strokec5 ]\
    \
    \cf15 \strokec15 # Loop 1: Casimir Base\cf5 \strokec5 \
    val_loop1 = CONSTANTS[\cf11 \strokec11 "pi"\cf5 \strokec5 ] * (CONSTANTS[\cf11 \strokec11 "alpha_inv"\cf5 \strokec5 ]**\cf14 \strokec14 2\cf5 \strokec5 )\
    \
    \cf15 \strokec15 # Loop 2: Trace Anomaly Correction\cf5 \strokec5 \
    val_loop2 = val_loop1 * (\cf14 \strokec14 1\cf5 \strokec5  - (\cf14 \strokec14 4.0\cf5 \strokec5 /\cf14 \strokec14 3.0\cf5 \strokec5 )*alpha)\
    \
    candidates_meta = \{\
        \cf11 \strokec11 "loop1"\cf5 \strokec5 : \{\cf11 \strokec11 "name"\cf5 \strokec5 : \cf11 \strokec11 "Loop 1 (Base)"\cf5 \strokec5 , \cf11 \strokec11 "val"\cf5 \strokec5 : val_loop1, \cf11 \strokec11 "form"\cf5 \strokec5 : \cf11 \strokec11 "pi * alpha^-2"\cf5 \strokec5 \},\
        \cf11 \strokec11 "loop2"\cf5 \strokec5 : \{\cf11 \strokec11 "name"\cf5 \strokec5 : \cf11 \strokec11 "Loop 2 (Corrected)"\cf5 \strokec5 , \cf11 \strokec11 "val"\cf5 \strokec5 : val_loop2, \cf11 \strokec11 "form"\cf5 \strokec5 : \cf11 \strokec11 "pi * alpha^-2 * (1 - 4/3*alpha)"\cf5 \strokec5 \}\
    \}\
\
    \cf15 \strokec15 # 2. Perform Sensitivity Sweep\cf5 \strokec5 \
    sweeps = []\
    best_error = \cf14 \strokec14 1.0\cf5 \strokec5 \
    best_config = \{\}\
    \
    \cf15 \strokec15 # Iterate H0\cf5 \strokec5 \
    \cf12 \strokec12 for\cf5 \strokec5  h0 \cf12 \strokec12 in\cf5 \strokec5  np.arange(params.h0_min, params.h0_max + \cf14 \strokec14 0.001\cf5 \strokec5 , params.h0_step):\
        \cf15 \strokec15 # Iterate Omega_Lambda\cf5 \strokec5 \
        \cf12 \strokec12 for\cf5 \strokec5  omega \cf12 \strokec12 in\cf5 \strokec5  np.arange(params.omega_lambda_min, params.omega_lambda_max + \cf14 \strokec14 0.001\cf5 \strokec5 , params.omega_step):\
            \
            \cf15 \strokec15 # Physics Calculation\cf5 \strokec5 \
            \cf15 \strokec15 # Convert H0 to SI (1/s)\cf5 \strokec5 \
            H0_si = h0 * \cf14 \strokec14 1000\cf5 \strokec5  / \cf14 \strokec14 3.08567758e22\cf5 \strokec5 \
            rho_crit = (\cf14 \strokec14 3\cf5 \strokec5  * H0_si**\cf14 \strokec14 2\cf5 \strokec5 ) / (\cf14 \strokec14 8\cf5 \strokec5  * CONSTANTS[\cf11 \strokec11 "pi"\cf5 \strokec5 ] * CONSTANTS[\cf11 \strokec11 "G"\cf5 \strokec5 ])\
            rho_L = omega * rho_crit\
            \
            \cf15 \strokec15 # Required Density for Tau0\cf5 \strokec5 \
            tau_s = params.tau0_myr * CONSTANTS[\cf11 \strokec11 "Myr_to_sec"\cf5 \strokec5 ]\
            rho_req = \cf14 \strokec14 1\cf5 \strokec5  / (\cf14 \strokec14 8\cf5 \strokec5  * CONSTANTS[\cf11 \strokec11 "pi"\cf5 \strokec5 ] * CONSTANTS[\cf11 \strokec11 "G"\cf5 \strokec5 ] * tau_s**\cf14 \strokec14 2\cf5 \strokec5 )\
            \
            \cf15 \strokec15 # Observed Ratio\cf5 \strokec5 \
            R_obs = rho_req / rho_L\
            \
            \cf15 \strokec15 # Check against Loop 2 (The Target)\cf5 \strokec5 \
            err = \cf16 \strokec16 abs\cf5 \strokec5 (R_obs - val_loop2) / val_loop2\
            \
            sweeps.append(SweepPoint(\
                H0=\cf16 \strokec16 round\cf5 \strokec5 (h0, \cf14 \strokec14 2\cf5 \strokec5 ),\
                Omega_L=\cf16 \strokec16 round\cf5 \strokec5 (omega, \cf14 \strokec14 3\cf5 \strokec5 ),\
                rho_req=rho_req,\
                rho_lambda=rho_L,\
                ratio_obs=R_obs,\
                loop2_error=err\
            ))\
            \
            \cf12 \strokec12 if\cf5 \strokec5  err < best_error:\
                best_error = err\
                best_config = \{\
                    \cf11 \strokec11 "H0"\cf5 \strokec5 : \cf16 \strokec16 round\cf5 \strokec5 (h0, \cf14 \strokec14 2\cf5 \strokec5 ), \
                    \cf11 \strokec11 "Omega_L"\cf5 \strokec5 : \cf16 \strokec16 round\cf5 \strokec5 (omega, \cf14 \strokec14 3\cf5 \strokec5 ), \
                    \cf11 \strokec11 "R_obs"\cf5 \strokec5 : R_obs\
