\f6\fs38\fsmilli19360 \AppleTypeServices\AppleTypeServicesF65539 \uc0\u8776 41.9
\f0\fs32 \AppleTypeServices\AppleTypeServicesF65539 \'a0Myr).\cb1 \
\pard\pardeftab720\sa320\partightenfactor0
