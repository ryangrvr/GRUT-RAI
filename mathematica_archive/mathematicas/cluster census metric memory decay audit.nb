Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", 
    RowBox[{"Protocol", ":", 
     RowBox[{"Cluster", " ", "Relaxation", " ", "Census"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauRelax", "=", "20"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Metric", " ", "memory", " ", "decay", " ", "constant", " ", "in", " ", 
     "Gyr"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "relaxation", " ", 
     RowBox[{"function", ":", 
      RowBox[{"f_DM", 
       RowBox[{"(", "t", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fDMTheory", "[", 
      RowBox[{"t_", ",", "f0_"}], "]"}], ":=", 
     RowBox[{"f0", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "tauRelax"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Observed", " ", 
     RowBox[{"Data", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Estimated", " ", "Age", " ", 
         RowBox[{"(", "Gyr", ")"}]}], ",", 
        RowBox[{"Observed", " ", 
         RowBox[{"M", "/", "L"}], " ", "or", " ", "Mass", " ", 
         "Discrepancy"}]}], "}"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Data", " ", "points", " ", 
     RowBox[{"represent", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Bullet", " ", "Cluster"}], ",", 
        RowBox[{"Coma", " ", "Cluster"}], ",", 
        RowBox[{"Abell", " ", "2029"}]}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"clusterData", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.5", ",", "13.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"7.2", ",", "10.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"13.8", ",", "7.0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Fit", " ", "the", " ", "initial", " ", "anomaly", " ", "amplitude", " ", 
     "f0", " ", "to", " ", "the", " ", "youngest", " ", "system", " ", 
     RowBox[{"(", 
      RowBox[{"Bullet", " ", "Cluster"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initialAmplitude", "=", 
     RowBox[{"13.5", "/", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "0.5"}], "/", "tauRelax"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"censusPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"fDMTheory", "[", 
          RowBox[{"t", ",", "initialAmplitude"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "15"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Dashed", ",", 
            RowBox[{"Thickness", "[", "0.008", "]"}]}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<System Age (Gyr)\>\"", 
            ",", "\"\<Mass Discrepancy (f_DM)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Cluster Census: Metric Memory Decay Audit\>\""}], ",", 
         RowBox[{"Background", "->", "Black"}], ",", 
         RowBox[{"FrameStyle", "->", "White"}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"clusterData", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Cyan", ",", 
            RowBox[{"PointSize", "[", "0.03", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabels", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Bullet\>\"", ",", "\"\<Abell\>\"", 
            ",", "\"\<Coma\>\""}], "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "censusPlot", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.975510460957892*^9, 3.97551046095994*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"6041bd28-6495-468e-aa55-2d3170a22bc2"],

