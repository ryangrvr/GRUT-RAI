Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Fresh", " ", 
    RowBox[{"Notebook", ":", 
     RowBox[{
     "The", " ", "Quantitative", " ", "Audit", " ", "of", " ", "the", " ", 
      "Bullet", " ", "Cluster"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Grover", " ", "Constants"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"offVal", "=", "6.0"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "Force", " ", "Intensity", " ", 
     RowBox[{"(", 
      RowBox[{"Lensing", " ", "Strength"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LensingIntensity", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rGas", ",", "rA", ",", "rB", ",", "fGas", ",", "fA", ",", "fB"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"rGas", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "0.1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rA", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "0.1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rB", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "0.1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Total", " ", "Force", " ", "Magnitude"}], "=", 
          RowBox[{"Newtonian", "+", 
           RowBox[{"Structural", " ", "Closure", " ", "Anomaly"}]}]}], "*)"}], 
        RowBox[{"fGas", "=", 
         RowBox[{
          RowBox[{"1.0", "/", 
           RowBox[{"rGas", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"R", "*", 
             RowBox[{"Sqrt", "[", "a0", "]"}]}], ")"}], "/", "rGas"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fA", "=", 
         RowBox[{
          RowBox[{"1.2", "/", 
           RowBox[{"rA", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"R", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "/", "rA"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fB", "=", 
         RowBox[{
          RowBox[{"1.2", "/", 
           RowBox[{"rB", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"R", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "/", "rB"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fGas", "+", "fA", "+", "fB"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Generate", " ", "the", " ", "Map"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plot", "=", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"LensingIntensity", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
       RowBox[{"PlotPoints", "->", "80"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Metric Memory Audit (R = 1.15428)\>\""}], ",", 
       
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Distance (Lag)\>\"", ",", "\"\<y\>\""}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Calculate", " ", 
     RowBox[{"the", "'"}], "Missing", " ", 
     RowBox[{"Mass", "'"}], " ", "Factor"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gasPeak", "=", 
     RowBox[{"LensingIntensity", "[", 
      RowBox[{"0", ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ghostPeak", "=", 
     RowBox[{"LensingIntensity", "[", 
      RowBox[{"offVal", ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"missingMassFactor", "=", 
     RowBox[{"ghostPeak", "/", 
      RowBox[{"(", 
       RowBox[{"1.2", "/", "0.1"}], ")"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Ratio", " ", "of", " ", "Anomaly", " ", "to", " ", "purely", " ", 
     "Newtonian", " ", "expected", " ", "value"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<--- Statistical Audit ---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Baryonic (Gas) Peak Intensity: \>\"", ",", "gasPeak"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ghost (Metric Memory) Peak Intensity: \>\"", ",", 
      "ghostPeak"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Calculated 'Dark Matter' Factor: \>\"", ",", 
      "missingMassFactor"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<-------------------------\>\"", "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", "plot"}]}]], "Input",
 CellChangeTimes->{{3.9754716250486393`*^9, 3.975471625050723*^9}},
