Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Grover", " ", "Constants", " ", "from", " ", "the", " ", "Protocol"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", 
     RowBox[{"1.2", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Grover", " ", "Acceleration", " ", "Scale"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Normalized", " ", "Mass", " ", "and", " ", "Positions", " ", "for", " ", 
     "the", " ", "Bullet", " ", "Cluster"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mgas", "=", "1.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Baryonic", " ", "center"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Mghost", "=", "1.2"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Residual", "'"}], 
      RowBox[{"Memory", "'"}], " ", "center"}], "-", 
     RowBox[{"slightly", " ", "stronger", " ", "lensing"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Lag", "=", "6.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Separation", " ", "observed", " ", "in", " ", "lensing", " ", "data"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "Grover", " ", "Force", " ", 
      RowBox[{"Field", ":", "g"}]}], "=", 
     RowBox[{"g_Newton", "+", "g_Anomaly"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "g_Anomaly", " ", "is", " ", "the", " ", "constant", " ", "acceleration", 
     " ", "floor", " ", "a0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GroverForce", "[", 
     RowBox[{"x_", ",", "y_", ",", "mx_", ",", "my_", ",", "m_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "mx"}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", "my"}], ")"}], "^", "2"}]}], "]"}], "+", 
         "0.5"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"m", "/", 
          RowBox[{"r", "^", "2"}]}], ")"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"m", "*", "R"}], ")"}]}]}], "]"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "R", " ", "modulates", " ", "the", " ", "anomaly", " ", "pressure"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "Gravitational", " ", "Influence", " ", "Map"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TotalForce", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"GroverForce", "[", 
        RowBox[{"x", ",", "y", ",", "0", ",", "0", ",", "Mgas"}], "]"}], "+", 
       
       RowBox[{"GroverForce", "[", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"-", "Lag"}], ",", "0", ",", "Mghost"}], "]"}], "+", 
       RowBox[{"GroverForce", "[", 
        RowBox[{"x", ",", "y", ",", "Lag", ",", "0", ",", "Mghost"}], "]"}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Density", " ", "Plot", " ", "of", " ", "the", " ", 
     RowBox[{"Gravitational", "'"}], "Lensing", " ", 
     RowBox[{"Strength", "'"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"TotalForce", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<Viridis\>\""}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Distance (kpc)\>\"", ",", "\"\<Distance (kpc)\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Spectral Lag: Gravitational Lensing without Dark \
Matter\>\""}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", "Thick", ",", 
        RowBox[{"Circle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", "0.6"}], "]"}], ",", 
        RowBox[{"Text", "[", 
