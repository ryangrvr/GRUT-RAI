Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"CMB", " ", "Power", " ", 
    RowBox[{"Spectrum", ":", 
     RowBox[{"Grover", " ", "Protocol", " ", 
      RowBox[{"$1", "/", 
       RowBox[{"k", "^", "4"}]}], "$", " ", "Noise", " ", "Audit"}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "Power", " ", "Spectrum", " ", "P", 
     RowBox[{"(", "k", ")"}], " ", "with", " ", 
     RowBox[{"1", "/", 
      RowBox[{"k", "^", "4"}]}], " ", "Anomaly", " ", "Residue"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PowerSpectrum", "[", "k_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"baryonOscillation", ",", "noiseKernel"}], "}"}], ",", 
       RowBox[{
        RowBox[{"baryonOscillation", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "k", "]"}], "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "^", "2"}], "+", "0.1"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"noiseKernel", "=", 
         RowBox[{"R", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "^", "4"}], "+", "0.01"}], ")"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"The", " ", 
          RowBox[{"1", "/", 
           RowBox[{"k", "^", "4"}]}], " ", "Anomaly", " ", "Floor"}], "*)"}], 
        
        RowBox[{"baryonOscillation", "+", "noiseKernel"}]}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"PowerSpectrum", "[", "k", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0.1", ",", "100"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Orange"}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Scale (k)\>\"", ",", "\"\<Power P(k)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<CMB Power Spectrum: The 1/k^4 Noise Floor (R=1.15428)\>\""}],
      ",", 
     RowBox[{"Filling", "->", "Bottom"}], ",", 
     RowBox[{"FillingStyle", "->", 
      RowBox[{"Opacity", "[", 
       RowBox[{"0.1", ",", "Orange"}], "]"}]}]}], "]"}]}]}]], "Input",
