Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sensitivity", " ", 
    RowBox[{"Analysis", ":", 
     RowBox[{"f_DM", " ", "vs", " ", "Cluster", " ", "Age"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauRelax", "=", "20"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "f_DM", " ", "as", " ", "a", " ", "function", " ", "of", " ", "time", " ",
      "for", " ", "a", " ", "fixed", " ", "radius", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"e", ".", "g", "."}], ",", 
       RowBox[{"r", "=", 
        RowBox[{"10", " ", "Mpc"}]}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rFixed", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fDMTime", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "*", 
        RowBox[{"Log", "[", 
         RowBox[{"rFixed", "+", "1"}], "]"}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "tauRelax"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", "rFixed"}], "+", "0.1"}], ")"}]}]}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"fDMTime", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Orange", ",", 
        RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<System Age (Gyr)\>\"", ",", "\"\<Apparent f_DM\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Metric Relaxation: The Fading Ghost\>\""}], ",", 
     
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "13.8", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"fDMTime", "[", "13.8", "]"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Mark", " ", "current", " ", "age", " ", "of", " ", "universe"}], 
      "*)"}], 
     RowBox[{"Background", "->", "Black"}], ",", 
     RowBox[{"FrameStyle", "->", "White"}]}], "]"}]}]}]], "Input",
