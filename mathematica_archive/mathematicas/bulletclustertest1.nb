Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", "Constants"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", 
     RowBox[{"1.2", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Grover", " ", "Acceleration", " ", "Scale"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"6.674", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "11"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Normalized", " ", "units", " ", "for", " ", 
      RowBox[{"visualization", ":", 
       RowBox[{"1", " ", "unit"}]}]}], "=", 
     RowBox[{"10", " ", "kpc"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mgas", "=", "1.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Stuck", " ", "in", " ", "the", " ", "center"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Mghost", "=", "0.8"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", "'"}], "Metric", " ", 
     RowBox[{"Memory", "'"}], " ", "center"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Lag", "=", "5.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "physical", " ", "offset", " ", "observed", " ", "in", " ", 
     "Bullet", " ", "Cluster"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "Grover", " ", 
     RowBox[{"Potential", ":", 
      RowBox[{"Newton", "+", 
       RowBox[{"Linear", " ", 
        RowBox[{"(", "Anomaly", ")"}]}]}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"We", " ", "use", " ", "a", " ", "soft"}], "-", 
      RowBox[{
      "core", " ", "potential", " ", "to", " ", "avoid", " ", "singularities",
        " ", "at", " ", "r"}]}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi", "[", 
     RowBox[{"x_", ",", "y_", ",", "Mx_", ",", "My_", ",", "mass_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "Mx"}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", "My"}], ")"}], "^", "2"}]}], "]"}], "+", 
         "0.1"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"mass", "/", "r"}], ")"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"mass", "*", "R", "*", "r"}], ")"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "two", " ", 
     RowBox[{"peaks", ":", 
      RowBox[{"The", " ", "Gas", " ", 
       RowBox[{"(", "Center", ")"}], " ", "and", " ", "the", " ", "Ghosts", " ", 
       RowBox[{"(", "Lags", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TotalPotential", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Phi", "[", 
       RowBox[{"x", ",", "y", ",", "0", ",", "0", ",", "Mgas"}], "]"}], "+", 
      RowBox[{"(*", 
       RowBox[{"Central", " ", "Gas"}], "*)"}], 
      RowBox[{"Phi", "[", 
       RowBox[{"x", ",", "y", ",", 
        RowBox[{"-", "Lag"}], ",", "0", ",", "Mghost"}], "]"}], "+", 
      RowBox[{"(*", 
       RowBox[{"Left", " ", "Ghost", " ", "Peak"}], "*)"}], 
      RowBox[{"Phi", "[", 
       RowBox[{"x", ",", "y", ",", "Lag", ",", "0", ",", "Mghost"}], 
       "]"}]}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{"Right", " ", "Ghost", " ", "Peak"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Visualize", " ", "the", " ", "Gravitational", " ", "Lensing", " ", 
     "Map"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"TotalPotential", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<Inferno\>\""}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Distance (kpc x10)\>\"", 
        ",", "\"\<Distance (kpc x10)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Bullet Cluster: Metric Memory (Lensing Peaks vs Gas \
Center)\>\""}], ",", 
