       RowBox[{"(*", 
        RowBox[{"Trough", " ", "2"}], "*)"}], 
       RowBox[{"{", 
        RowBox[{"809.8", ",", "2518"}], "}"}]}], "   ", 
      RowBox[{"(*", 
       RowBox[{"Peak", " ", "3"}], "*)"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Rendering", " ", "the", " ", "Synthesis"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"GroverCMB", "[", "k", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "2", ",", "1000"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Orange"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Multipole Moment (l)\>\"", 
          ",", "\"\<Power (uK^2)\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<The Universal Audit: R=1.15428 vs. Planck Legacy \
Data\>\""}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"planckData", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
