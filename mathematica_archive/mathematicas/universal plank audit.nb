Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"The", " ", "Universal", " ", 
    RowBox[{"Audit", ":", 
     RowBox[{"Grover", " ", "Protocol", " ", 
      RowBox[{"vs", ".", "Planck"}], " ", "Satellite", " ", "Data"}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Define", " ", "the", " ", "Grover", " ", "Model"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GroverCMB", "[", "k_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"baryons", ",", "memory"}], "}"}], ",", 
       RowBox[{
        RowBox[{"baryons", "=", 
         RowBox[{"5733", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"0.015", " ", "k"}], "]"}], "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"0.0001", " ", 
               RowBox[{"k", "^", "2"}]}], "+", "1"}], ")"}]}], ")"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Scaled", " ", "Baryon", " ", "Oscillation"}], "*)"}], 
        RowBox[{"memory", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"R", "*", "4000"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "^", "0.8"}], "+", "0.1"}], ")"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"The", " ", 
          RowBox[{"1", "/", 
           RowBox[{"k", "^", "4"}]}], " ", "Spectral", " ", "Floor", " ", 
          "proxy"}], "*)"}], 
        RowBox[{"baryons", "+", "memory"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Actual", " ", "Planck", " ", "2018", " ", "TT", " ", "Peak", " ",
      "Data", " ", "Points", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Multipole", " ", "l"}], ",", "Amplitude"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"planckData", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"220.6", ",", "5733"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Peak", " ", "1"}], "*)"}], 
       RowBox[{"{", 
        RowBox[{"416.3", ",", "1713"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Trough", " ", "1"}], "*)"}], 
       RowBox[{"{", 
        RowBox[{"538.1", ",", "2586"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Peak", " ", "2"}], "*)"}], 
       RowBox[{"{", 
