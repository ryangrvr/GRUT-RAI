Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", "Population", " ", "Optimizer"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Residual", " ", "function", " ", "for", " ", "a", " ", "test", " ", 
     "population"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TotalError", "[", 
      RowBox[{"n_", ",", "gamma_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "vPred", ",", "vAnomSq"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Sample", " ", "data", " ", 
           RowBox[{"point", ":", "LogMb"}]}], "=", "10"}], ",", 
         RowBox[{"SigmaB", "=", "500"}], ",", 
         RowBox[{"r", "=", "15"}], ",", 
         RowBox[{"vObs", "=", "200"}], ",", 
         RowBox[{"vBar", "=", "140"}]}], "*)"}], 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0.35", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"10", "^", "10"}], ")"}], "^", "n"}]}], ")"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"500", "/", "500"}], ")"}], "^", "gamma"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vAnomSq", "=", 
         RowBox[{
          RowBox[{"220", "^", "2"}], "*", "15", "*", 
          RowBox[{"(", 
           RowBox[{"R", "/", 
            RowBox[{"(", 
             RowBox[{"15", "+", "s"}], ")"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vPred", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"140", "^", "2"}], "+", "vAnomSq"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Abs", "[", 
         RowBox[{"200", "-", "vPred"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Find", " ", "the", " ", "global", " ", "minimum", " ", "for", " ", "the",
      " ", "scaling", " ", "exponents"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"NMinimize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TotalError", "[", 
        RowBox[{"n", ",", "gamma"}], "]"}], ",", 
       RowBox[{"0.2", "<", "n", "<", "0.4"}], ",", 
       RowBox[{"0.3", "<", "gamma", "<", "0.7"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "gamma"}], "}"}]}], "]"}]}]}]], "Input",
