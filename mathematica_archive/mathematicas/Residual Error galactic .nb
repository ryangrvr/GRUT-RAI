Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", 
    RowBox[{"Protocol", ":", 
     RowBox[{"SPARC", "-", 
      RowBox[{"Dataset", " ", "Residual", " ", "Analyzer"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Grover", " ", "Velocity", " ", 
     RowBox[{
      RowBox[{"vs", ".", "Newtonian"}], "/", "Baryonic"}], " ", "Velocity"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"vGrover", "^", "2"}], "=", 
     RowBox[{
      RowBox[{"vBaryon", "^", "2"}], "+", 
      RowBox[{"vAnomaly", "^", "2"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "vAnomaly", " ", "is", " ", "the", " ", "Grover", " ", "contribution", " ",
       "derived", " ", "from", " ", "the", " ", "R"}], "-", "potential"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vAnomaly", "[", 
      RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Max", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"220", "^", "2"}], "*", "r", "*", 
         RowBox[{"(", 
          RowBox[{"R", "/", 
           RowBox[{"(", 
            RowBox[{"r", "+", "s"}], ")"}]}], ")"}]}]}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"vTotal", "[", 
      RowBox[{"r_", ",", "vBaryon_", ",", "s_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"vBaryon", "^", "2"}], "+", 
       RowBox[{
        RowBox[{"vAnomaly", "[", 
         RowBox[{"r", ",", "s"}], "]"}], "^", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Sample", " ", "Data", " ", "Input", " ", 
     RowBox[{"(", 
      RowBox[{"Radius", ",", "vObs", ",", "vBaryon"}], ")"}]}], "*)"}], "\n", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"In", " ", "practice"}], ",", 
     RowBox[{
     "this", " ", "would", " ", "be", " ", "a", " ", "List", " ", "of", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", "vObs", ",", "vBaryon"}], "}"}], " ", "from", " ", 
      "the", " ", "SPARC", " ", "catalog"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"sampleGalaxy", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2.1", ",", "150", ",", "110"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"5.5", ",", "190", ",", "140"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"12.3", ",", "220", ",", "150"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"25.0", ",", "230", ",", "145"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Residual", " ", "Calculation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"residuals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"vTotal", "[", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"data", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "1.5"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"data", ",", "sampleGalaxy"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "Results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Residuals (Observed - Grover Fit): \>\"", ",", 
      "residuals"}], "]"}], ";"}], "\n", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"residuals", ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Residual Error across Galactic Radius\>\""}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}], ",", 
     RowBox[{"Background", "->", "Black"}], ",", 
     RowBox[{"FrameStyle", "->", "White"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.975510259990197*^9, 3.975510259992198*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"eb1ce126-6d95-45d3-87f3-e7f215230f73"],

