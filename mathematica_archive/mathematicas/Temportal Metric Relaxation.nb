Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"The", " ", "Universal", " ", "Master", " ", 
    RowBox[{"Map", ":", 
     RowBox[{"Integrated", " ", "Grover", " ", "Protocol", " ", "Proof"}]}]}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Universal", " ", "Constants", " ", "established", " ", "in", " ", "the", 
     " ", "Audit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauRelax", "=", "20"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"20", " ", "Gyr", " ", "Relaxation", " ", "Horizon"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "Grover", " ", "Potential", " ", "Function"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"s", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "+", "0.1"}], ")"}]}], ")"}], "+", 
      RowBox[{"R", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "+", "s"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Apparent", " ", "Dark", " ", "Matter", " ", "Fraction", " ", "fDM", 
     RowBox[{"(", 
      RowBox[{"r", ",", "t"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fDM", "[", 
      RowBox[{"r_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "*", 
        RowBox[{"Log", "[", 
         RowBox[{"r", "+", "1"}], "]"}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "tauRelax"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", "r"}], "+", "0.1"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Asymptotic", " ", "Convergence", " ", "Bound"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RelativeDiff", "[", 
      RowBox[{"r_", ",", "s1_", ",", "s2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"r", ",", "s1"}], "]"}], "-", 
        RowBox[{"V", "[", 
         RowBox[{"r", ",", "s2"}], "]"}]}], "]"}], "/", 
      RowBox[{"V", "[", 
       RowBox[{"r", ",", "s1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Master"}]}], " ", "Visualization", " ", 
      RowBox[{"Suite", "--"}]}], "-"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"masterSuite", "=", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Panel", " ", "1"}], ":", 
           RowBox[{"The", " ", "3", "D", " ", "Decay", " ", "Manifold", " ", 
            RowBox[{"(", 
             RowBox[{"Observable", " ", "Reality"}], ")"}]}]}], "*)"}], 
         RowBox[{
          RowBox[{"Plot3D", "[", 
           RowBox[{
            RowBox[{"fDM", "[", 
             RowBox[{"r", ",", "t"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "1", ",", "50"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Radius\>\"", ",", "\"\<Time\>\"", 
               ",", "\"\<f_DM\>\""}], "}"}]}], ",", 
            RowBox[{"ColorFunction", "->", "\"\<DeepSeaColors\>\""}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Temporal Metric Relaxation\>\"", ",", "12"}], 
              "]"}]}], ",", 
            RowBox[{"Boxed", "->", "False"}], ",", 
            RowBox[{"Background", "->", "Black"}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Panel", " ", "2"}], ":", 
            RowBox[{"Asymptotic", " ", "Convergence", " ", 
             RowBox[{"(", 
              RowBox[{"Mathematical", " ", "Bound"}], ")"}]}]}], "*)"}], 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"Evaluate", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"RelativeDiff", "[", 
                RowBox[{"r", ",", "0.05", ",", "s2"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"s2", ",", 
                 RowBox[{"{", 
                  RowBox[{"1.0", ",", "10.0"}], "}"}]}], "}"}]}], "]"}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "0.1", ",", "500"}], "}"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0.1"}], "}"}]}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{"Cyan", ",", "Magenta"}], "}"}]}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Radius (Log r)\>\"", ",", "\"\<Convergence\>\""}], 
              "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Asymptotic Bound (r -> 500)\>\"", ",", "12"}], 
              "]"}]}], ",", 
            RowBox[{"Background", "->", "Black"}], ",", 
            RowBox[{"FrameStyle", "->", "White"}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "}"}], "}"}], ",", 
       RowBox[{"Frame", "->", "All"}], ",", 
       RowBox[{"FrameStyle", "->", "Gray"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"10", ",", "10"}], "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "masterSuite", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.97550667945319*^9, 3.975506679455243*^9}},
