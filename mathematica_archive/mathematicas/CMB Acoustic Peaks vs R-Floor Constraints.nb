Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"CMB", " ", "Stress", " ", 
    RowBox[{"Test", ":", 
     RowBox[{"R", "-", 
      RowBox[{
      "Floor", " ", "Impact", " ", "on", " ", "Power", " ", 
       "Spectrum"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Power", " ", "Spectrum", " ", "P", 
      RowBox[{"(", "k", ")"}], " ", "influenced", " ", "by", " ", "the", " ", 
      "Anomaly"}], "-", 
     RowBox[{"Induced", " ", "Floor"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Standard", " ", "P", 
      RowBox[{
       RowBox[{
        RowBox[{"(", "k", ")"}], "~", "k"}], "^", "n"}]}], ";", 
     RowBox[{"Grover", " ", "P", 
      RowBox[{
       RowBox[{
        RowBox[{"(", "k", ")"}], "~", "1"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "+", 
         RowBox[{"R", "*", 
          RowBox[{"k", "^", "4"}]}]}], ")"}]}], " ", "scaled", " ", "to", " ",
       "multipoles"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"powerSpectrum", "[", "l_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "*", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "^", "2"}], "+", 
        RowBox[{"R", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "/", "100"}], ")"}], "^", "4"}]}]}], ")"}]}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Standard", " ", "LCDM"}], "-", 
     RowBox[{
     "like", " ", "approximation", " ", "for", " ", "the", " ", "First", " ", 
      "Acoustic", " ", "Peak"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"standardCMB", "[", "l_", "]"}], ":=", 
     RowBox[{"1000", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "220"}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"50", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Grover", "-", 
     RowBox[{"Modified", " ", "Acoustic", " ", "Peak"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"groverCMB", "[", "l_", "]"}], ":=", 
     RowBox[{
      RowBox[{"standardCMB", "[", "l", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"(", 
           RowBox[{"R", "*", 
            RowBox[{"l", "/", "1000"}]}], ")"}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stressTestPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"standardCMB", "[", "l", "]"}], ",", 
         RowBox[{"groverCMB", "[", "l", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", "1000"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Gray", ",", "Dashed"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Cyan", ",", 
            RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}]}], "}"}]}], ",", 
       
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Multipole Moment (l)\>\"", 
          ",", "\"\<Temperature Fluctuations (\[Mu]K^2)\>\""}], "}"}]}], ",", 
       
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Stress Test: CMB Acoustic Peaks vs. R-Floor \
Constraints\>\""}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Standard LCDM\>\"", 
          ",", "\"\<Grover R-Floor Modified\>\""}], "}"}]}], ",", 
       RowBox[{"Background", "->", "Black"}], ",", 
       RowBox[{"FrameStyle", "->", "White"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "stressTestPlot", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9755094010468187`*^9, 3.9755094010492277`*^9}},
