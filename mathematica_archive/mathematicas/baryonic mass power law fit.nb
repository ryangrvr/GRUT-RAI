Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", 
    RowBox[{"Protocol", ":", 
     RowBox[{"s", "-", 
      RowBox[{"Scaling", " ", "Law", " ", "Correlation"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Data", " ", "from", " ", "Population", " ", 
     RowBox[{"Study", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log10", 
         RowBox[{"(", "M_baryon", ")"}]}], ",", 
        RowBox[{"Fitted", " ", "s"}]}], "}"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Representing", " ", "Dwarf"}], ",", "Spiral", ",", 
     RowBox[{"and", " ", "Massive", " ", "Elliptical", " ", "scales"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scalingData", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8.5", ",", "0.8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"10.5", ",", "2.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"12.0", ",", "12.0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Linear", " ", "fit", " ", "in", " ", "Log"}], "-", 
     RowBox[{"Log", " ", "space", " ", "to", " ", "test", " ", "power"}], "-", 
     RowBox[{"law", " ", "relationship", " ", 
      RowBox[{
       RowBox[{"s", "~", "M_b"}], "^", "n"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logScalingData", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"Log10", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], ",", 
       "scalingData"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"logScalingData", ",", "x", ",", "x"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sPredictor", "[", "logMb_", "]"}], ":=", 
     RowBox[{"10", "^", 
      RowBox[{"fit", "[", "logMb", "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"correlationPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListLogLogPlot", "[", 
        RowBox[{"scalingData", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Cyan", ",", 
            RowBox[{"PointSize", "[", "0.03", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabels", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Dwarf\>\"", ",", "\"\<Spiral\>\"", 
            ",", "\"\<Elliptical\>\""}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Baryonic Mass (Log M_sun)\>\"", 
            ",", "\"\<Transition Scale s (kpc)\>\""}], "}"}]}]}], "]"}], ",", 
       
       RowBox[{"LogLogPlot", "[", 
        RowBox[{
         RowBox[{"sPredictor", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "8", ",", "13"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Orange", ",", "Dashed"}], "}"}]}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Power Law Fit (s ~ M_b^n): n = \>\"", ",", 
      RowBox[{
       RowBox[{"fit", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "correlationPlot", "]"}], ";"}]}]}]], "Input",
