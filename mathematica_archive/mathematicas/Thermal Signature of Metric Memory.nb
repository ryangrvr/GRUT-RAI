Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Vanguard", " ", 
    RowBox[{"Audit", ":", 
     RowBox[{
     "Thermodynamic", " ", "Entropy", " ", "of", " ", "the", " ", "Metric", " ",
       "Memory"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";", 
    RowBox[{"a0", "=", "1.0"}], ";", 
    RowBox[{"offVal", "=", "6.0"}], ";", 
    RowBox[{"softening", "=", "0.05"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "Audit", " ", "Potential", " ", 
     RowBox[{"(", 
      RowBox[{"The", " ", "Informational", " ", "Density"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AuditPotential", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rGas", ",", "rA", ",", "rB"}], "}"}], ",", 
       RowBox[{
        RowBox[{"rGas", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rA", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rB", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1.0", "/", "rGas"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "*", 
              RowBox[{"Sqrt", "[", "a0", "]"}]}], ")"}], "*", 
            RowBox[{"Log", "[", "rGas", "]"}]}]}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1.2", "/", "rA"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "*", 
            RowBox[{"Log", "[", "rA", "]"}]}]}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1.2", "/", "rB"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "*", 
            RowBox[{"Log", "[", "rB", "]"}]}]}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Entropy", " ", "is", " ", "inversely", " ", "proportional", " ", "to", " ",
      "the", " ", "structured", " ", "Audit", " ", "potential"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MetricEntropy", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"AuditPotential", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "+", "0.1"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Visualize", " ", "the", " ", 
     RowBox[{"Entropy", "'"}], 
     RowBox[{"Cooling", "'"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"MetricEntropy", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
     RowBox[{"PlotPoints", "->", "90"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Entropy Gradient: The Thermal Signature of Metric \
Memory\>\""}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x (Lag)\>\"", ",", "\"\<y\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.975472167919059*^9, 3.975472167921036*^9}},
