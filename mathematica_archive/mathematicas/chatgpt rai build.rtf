# reconstructor.py\
from __future__ import annotations\
import numpy as np\
from dataclasses import dataclass\
\
def soft_threshold(u: np.ndarray, lam: float) -> np.ndarray:\
    """Soft thresholding operator (L1 sparsity)."""\
    return np.sign(u) * np.maximum(np.abs(u) - lam, 0.0)\
\
@dataclass\
class LCAConfig:\
    lam: float = 0.05          # sparsity strength\
    step: float = 0.2          # integration step\
    max_iter: int = 2000\
    tol: float = 1e-6          # stop when relative change small\
    nonnegative: bool = True   # sources are often >=0\
\
@dataclass\
class LCAResult:\
    x_hat: np.ndarray\
    residual_norm: float\
    iters: int\
    converged: bool\
    diagnostics: dict\
\
class LCAReconstructor:\
    """\
    LCA solver for sparse inverse problems.\
\
    Objective (typical):\
      minimize_x  0.5 ||y - A x||^2 + lam * ||x||_1\
    """\
\
    def __init__(self, cfg: LCAConfig = LCAConfig()):\
        self.cfg = cfg\
\
    def fit(self, y: np.ndarray, A: np.ndarray, x0: np.ndarray | None = None) -> LCAResult:\
        A = np.asarray(A, dtype=float)\
        y = np.asarray(y, dtype=float).reshape(-1)\
\
        m, n = A.shape\
        if y.shape[0] != m:\
            raise ValueError(f"y has length \{y.shape[0]\} but A is \{A.shape\}")\
\
        # Normalize columns to help stability (optional but usually helpful)\
        col_norms = np.linalg.norm(A, axis=0)\
        col_norms = np.maximum(col_norms, 1e-12)\
        A_norm = A / col_norms[None, :]\
\
        # Precompute for speed\
        AT = A_norm.T\
\
        # Init\
        u = np.zeros(n, dtype=float)\
        if x0 is None:\
            x = np.zeros(n, dtype=float)\
        else:\
            x = np.asarray(x0, dtype=float).reshape(n)\
\
        converged = False\
        prev_x = x.copy()\
\
        for k in range(1, self.cfg.max_iter + 1):\
            # residual\
            r = y - (A_norm @ x)\
\
            # LCA dynamics (one common discrete form)\
            # u <- u + step*(A^T r - u)\
            u = u + self.cfg.step * (AT @ r - u)\
\
            # activation (sparse)\
            x = soft_threshold(u, self.cfg.lam)\
            if self.cfg.nonnegative:\
                x = np.maximum(x, 0.0)\
\
            # check convergence\
            dx = np.linalg.norm(x - prev_x) / (np.linalg.norm(prev_x) + 1e-12)\
            if dx < self.cfg.tol:\
                converged = True\
                break\
            prev_x[:] = x\
\
        # unnormalize back\
        x_hat = x / col_norms\
        residual = y - (A @ x_hat)\
        res_norm = float(np.linalg.norm(residual))\
\
        diagnostics = \{\
            "dx_rel": float(dx),\
            "lam": self.cfg.lam,\
            "step": self.cfg.step,\
            "col_norm_min": float(col_norms.min()),\
            "col_norm_max": float(col_norms.max()),\
        \}\
\
        return LCAResult(\
            x_hat=x_hat,\
            residual_norm=res_norm,\
            iters=k,\
            converged=converged,\
            diagnostics=diagnostics,\
        )\
