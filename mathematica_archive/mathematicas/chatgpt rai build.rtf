import mpmath as mp\
\
# ----------------------------\
# GRUT Force RAI \'97 Zeta Anamnesis (Instrument-grade)\
# ----------------------------\
\
def scan_zeros_on_critical_line(t0=0.0, t1=50.0, step=0.05, dps=50, refine_tol=1e-10):\
    """\
    Finds zeros on the critical line using Hardy Z (mp.siegelz).\
    This does NOT prove RH; it verifies in a finite interval.\
    """\
    mp.mp.dps = dps\
\
    def Z(t):\
        return mp.siegelz(t)  # real on the critical line\
\
    zeros = []\
    brackets = []\
\
    # coarse scan for sign changes in Z(t)\
    t = mp.mpf(t0)\
    z_prev = Z(t)\
    t_prev = t\
\
    t += step\
    while t <= t1:\
        z_cur = Z(t)\
        # sign change or near-zero crossing\
        if z_prev == 0 or z_cur == 0 or (z_prev > 0 and z_cur < 0) or (z_prev < 0 and z_cur > 0):\
            brackets.append((t_prev, t))\
        t_prev, z_prev = t, z_cur\
        t += step\
\
    # refine each bracket into a root\
    for (a, b) in brackets:\
        try:\
            # good initial guesses: endpoints of bracket\
            root = mp.findroot(Z, (a, b), tol=refine_tol, maxsteps=50)\
\
            # dedupe: avoid duplicates from adjacent brackets\
            if not zeros or abs(root - zeros[-1]) > mp.mpf("1e-6"):\
                zeros.append(root)\
        except Exception:\
            # If findroot fails, skip (still instrument-honest)\
            continue\
\
    # verification: evaluate zeta magnitude at the found roots\
    verifications = []\
    for t0 in zeros:\
        s = mp.mpf("0.5") + 1j * t0\
        z = mp.zeta(s)\
        verifications.append(\{\
            "t": float(t0),\
            "abs_zeta": float(abs(z)),\
            "re_zeta": float(mp.re(z)),\
            "im_zeta": float(mp.im(z)),\
        \})\
\
    # "ZIS" certificate: numerical integrity summary\
    cert = \{\
        "schema": "grut-zis-v1",\
        "status": "PASS" if len(zeros) > 0 else "WARN",\
        "interval": \{"t0": float(t0), "t1": float(t1)\},\
        "scan": \{"step": float(step), "dps": int(dps), "refine_tol": float(refine_tol)\},\
        "found_zero_count": len(zeros),\
        "notes": [\
            "Zeros are located on the critical line by construction (Hardy Z).",\
            "This is a finite-range verification, not a proof of RH.",\
            "If no zeros found, reduce step or increase dps."\
        ],\
    \}\
\
    return zeros, verifications, cert\
\
\
if __name__ == "__main__":\
    zeros, verifications, cert = scan_zeros_on_critical_line(\
        t0=0.0,\
        t1=50.0,\
        step=0.05,   # smaller step finds sign changes more reliably\
        dps=60,      # higher precision is safer\
        refine_tol=1e-12\
    )\
\
    print("ZIS:", cert)\
    print("First zeros (t):")\
    for t in zeros[:10]:\
        print(" ", t)\
\
    print("\\nVerification samples:")\
    for v in verifications[:5]:\
        print(v)\
