# simulator.py\
from __future__ import annotations\
import numpy as np\
from dataclasses import dataclass\
\
@dataclass\
class KernelSpec:\
    """Defines a causal memory kernel K(
\f8 \uc0\u916 
\f7 t) with 
\f8 \uc0\u916 
\f7 t >= 0."""\
    tau0_s: float\
    alpha: float = 1.0  # overall gain (can map to your engine's kernel_mass style)\
\
def causal_exp_kernel(dt_s: np.ndarray, spec: KernelSpec) -> np.ndarray:\
    """\
    K(
\f8 \uc0\u916 
\f7 t) = (alpha/tau0) * exp(-
\f8 \uc0\u916 
\f7 t/tau0) for 
\f8 \uc0\u916 
\f7 t >= 0 else 0\
    dt_s must be >= 0.\
    """\
    tau0 = float(spec.tau0_s)\
    return (spec.alpha / tau0) * np.exp(-dt_s / tau0)\
\
def build_drm(time_s: np.ndarray, spec: KernelSpec, normalize_rows: bool = True) -> np.ndarray:\
    """\
    Build a DRM matrix A where y_i = sum_j A[i,j] x_j, using a causal kernel.\
    Convention: time increases forward; observation at time_i receives contributions\
    from sources at times <= time_i.\
\
    time_s: 1D grid (monotonic increasing)\
    """\
    t = np.asarray(time_s, dtype=float)\
    if t.ndim != 1 or len(t) < 2:\
        raise ValueError("time_s must be a 1D array with length >= 2")\
    if not np.all(np.diff(t) > 0):\
        raise ValueError("time_s must be strictly increasing")\
\
    n = len(t)\
    A = np.zeros((n, n), dtype=float)\
\
    # 
\f8 \uc0\u916 
\f7 t = t_i - t_j (causal: only if i >= j)\
    for i in range(n):\
        dt = t[i] - t[: i + 1]  # >=0\
        A[i, : i + 1] = causal_exp_kernel(dt, spec)\
\
    # Approximate integration weights (Riemann)\
    # Multiply columns by dt to make A approximate convolution integral.\
    dt_grid = np.diff(t, prepend=t[0])\
    A = A * dt_grid[None, :]\
\
    if normalize_rows:\
        row_sums = A.sum(axis=1, keepdims=True)\
        # avoid divide-by-zero if someone passes pathological spec\
        A = np.divide(A, np.maximum(row_sums, 1e-30))\
\
    return A\
\
def simulate_observation(A: np.ndarray, x: np.ndarray, noise_sigma: float = 0.0, seed: int | None = None) -> np.ndarray:\
    """\
    Forward model: y = A x + noise\
    """\
    A = np.asarray(A, dtype=float)\
    x = np.asarray(x, dtype=float)\
    y = A @ x\
    if noise_sigma > 0:\
        rng = np.random.default_rng(seed)\
        y = y + rng.normal(0.0, noise_sigma, size=y.shape)\
    return y\
