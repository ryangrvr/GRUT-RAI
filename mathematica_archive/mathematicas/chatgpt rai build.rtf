import numpy as np\
from dataclasses import dataclass\
\
@dataclass(frozen=True)\
class GRUTParams:\
    version: str = "grut-rai-2026.1"\
    lambda_lock: float = 1.1547\
    tau0_myr: float = 41.9\
    gmax: float = 4.0/3.0\
    rho_lock: float = 1.0     # define your normalization explicitly\
    cap_sigma: float = 0.1    # your sigma (cap_softness for L_stiff)\
    min_softness: float = 1e-3  # softness for smooth_min (separate knob)\
\
    elasticity_base: float = 0.75\
    dissipation_k: float = 20.0   # example; you set via calibration\
    phase_x0: float = 0.5         # center in x=ln(1+z)\
    phase_w: float = 0.2          # width\
\
    stationary_phase: float = 217.18\
\
def phase_sigmoid(z, x0, w):\
    x = np.log1p(z)\
    return 1.0 / (1.0 + np.exp((x - x0)/w))\
\
def stiff_cap_gain(chi, gmax, sigma):\
    return 1.0 + (gmax - 1.0) * (chi / (chi + sigma))\
\
def smooth_min(a, b, softness):\
    return -softness * np.log(np.exp(-a/softness) + np.exp(-b/softness))\
\
def run_engine(z, rho, v, params: GRUTParams, eps_t_myr, phi_mode="S_phase"):\
    z = np.asarray(z, dtype=np.float64)\
    rho = np.asarray(rho, dtype=np.float64)\
    v = np.asarray(v, dtype=np.float64)\
\
    # 1) regime bridge\
    S = phase_sigmoid(z, params.phase_x0, params.phase_w)\
\
    # 2) kernel boost (placeholder: you plug in your real vectorized kernel)\
    b_raw = kernel_boost(z, rho, v, params)        # -> array\
    b = b_raw * S\
    g_raw = 1.0 + b\
\
    # 3) stiffness cap\
    chi = rho / params.rho_lock\
    L = stiff_cap_gain(chi, params.gmax, params.cap_sigma)\
    g_eff = smooth_min(g_raw, L, params.min_softness)\
\
    # 4) dissipation\
    if phi_mode == "S_phase":\
        phi = S\
    elif phi_mode == "one_minus_S":\
        phi = 1.0 - S\
    else:\
        phi = np.ones_like(S)\
\
    fuzz_fraction = eps_t_myr / params.tau0_myr\
    D = params.dissipation_k * fuzz_fraction * phi\
    E_obs = params.elasticity_base * (1.0 - D)\
\
    # 5) outputs (you\'92ll define how these map to your f
\f8 \uc0\u963 
\f7 8)\
    G_eff = g_eff\
    f_sigma8 = compute_f_sigma8(z, G_eff, E_obs, params)\
\
    # 6) certificate hooks (you\'92d return a structured NIS report)\
    cert = \{\
        "eps_t_myr": float(eps_t_myr),\
        "fuzz_fraction": float(fuzz_fraction),\
        "D_max": float(np.max(D)),\
        "cap_engaged_frac": float(np.mean(g_raw > L)),\
        "S_stats": [float(np.min(S)), float(np.mean(S)), float(np.max(S))],\
    \}\
\
    return G_eff, f_sigma8, cert\
