import numpy as np\
from .simulator import make_kernel_exp, forward_convolve\
from .reconstructor import lca_reconstruct\
from .evaluator import score_shadow, ris_from_scores\
\
def search_tau_grid(\
    y_obs: np.ndarray,\
    dt_s: float,\
    tau_candidates_s: list[float],\
    n_kernel: int,\
    lam: float,\
    max_iter: int,\
    tol: float,\
    nonnegative: bool,\
    thresholds: dict\
):\
    y_obs = np.asarray(y_obs, dtype=float)\
    scores = []\
    admissible_idxs = []\
\
    for idx, tau_s in enumerate(tau_candidates_s):\
        kernel = make_kernel_exp(dt_s=dt_s, tau_s=float(tau_s), n_kernel=n_kernel)\
\
        # reconstruct x_hat\
        rec = lca_reconstruct(\
            y_obs=y_obs,\
            kernel=kernel,\
            lam=lam,\
            max_iter=max_iter,\
            tol=tol,\
            nonnegative=nonnegative,\
        )\
\
        y_hat = forward_convolve(rec.x_hat, kernel)\
\
        # score on shadow-space (the detector sees y)\
        s = score_shadow(y_obs=y_obs, y_hat=y_hat, dt_s=dt_s)\
\
        # RIS status for this tau (per-candidate)\
        ris = ris_from_scores(\
            emd_shadow=s["emd_shadow"],\
            residual_norm=s["residual_norm"],\
            converged=rec.converged,\
            thresholds=thresholds\
        )\
\
        scores.append(\{\
            "tau_s": float(tau_s),\
            "emd_shadow": float(s["emd_shadow"]),\
            "residual_norm": float(s["residual_norm"]),\
            "objective": float(s["objective"]),\
            "ris_status": ris["status"],\
            "converged": bool(rec.converged),\
            "iters": int(rec.iters),\
        \})\
\
        if ris["status"] in ("PASS", "WARN"):\
            admissible_idxs.append(idx)\
\
    # choose best among admissible by objective (or emd_shadow+residual combo)\
    if admissible_idxs:\
        best_idx = min(admissible_idxs, key=lambda i: scores[i]["objective"])\
        return best_idx, scores\
    else:\
        return None, scores\
