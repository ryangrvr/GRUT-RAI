# evaluator.py\
from __future__ import annotations\
import numpy as np\
from dataclasses import dataclass\
\
try:\
    # SciPy gives a clean 1D EMD via Wasserstein\
    from scipy.stats import wasserstein_distance\
except Exception as e:\
    wasserstein_distance = None\
\
@dataclass\
class EvalReport:\
    emd: float\
    l2: float\
    linf: float\
    notes: dict\
\
def _normalize_as_distribution(v: np.ndarray) -> np.ndarray:\
    v = np.asarray(v, dtype=float)\
    v = np.maximum(v, 0.0)\
    s = v.sum()\
    if s <= 0:\
        # fallback: uniform tiny mass to avoid division errors\
        return np.ones_like(v) / len(v)\
    return v / s\
\
def emd_1d(x_grid: np.ndarray, p: np.ndarray, q: np.ndarray) -> float:\
    """\
    1D Earth Mover Distance = Wasserstein-1 distance.\
    Requires scipy.\
    """\
    if wasserstein_distance is None:\
        raise RuntimeError("scipy is required for emd_1d (scipy.stats.wasserstein_distance).")\
\
    x = np.asarray(x_grid, dtype=float).reshape(-1)\
    p = _normalize_as_distribution(p).reshape(-1)\
    q = _normalize_as_distribution(q).reshape(-1)\
\
    # wasserstein_distance takes positions + weights\
    return float(wasserstein_distance(x, x, u_weights=p, v_weights=q))\
\
def compare_signals(x_grid: np.ndarray, y_true: np.ndarray, y_pred: np.ndarray) -> EvalReport:\
    """\
    Returns EMD (if available) plus L2 and Linf for sanity.\
    """\
    y_true = np.asarray(y_true, dtype=float).reshape(-1)\
    y_pred = np.asarray(y_pred, dtype=float).reshape(-1)\
\
    l2 = float(np.linalg.norm(y_true - y_pred))\
    linf = float(np.max(np.abs(y_true - y_pred)))\
\
    notes = \{\}\
    if wasserstein_distance is not None:\
        emd = emd_1d(x_grid, y_true, y_pred)\
    else:\
        emd = float("nan")\
        notes["emd_warning"] = "scipy missing; EMD not computed"\
\
    return EvalReport(emd=emd, l2=l2, linf=linf, notes=notes)\
