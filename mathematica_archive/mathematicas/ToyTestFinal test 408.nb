Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"CEFT", ",", "Ccosmo", ",", "Cobs"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Simple", " ", "quadratic", " ", "penalties", " ", "around", " ", "each", " ",
     "target"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CEFT", "[", "ng_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"ng", "-", "ngEFTTarget"}], ")"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ccosmo", "[", "ng_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"ng", "-", "ngCosmoTarget"}], ")"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Cobs", "[", "ng_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"ng", "-", "ngObsTarget"}], ")"}], "^", "2"}]}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9757283629718533`*^9, 3.975728362973927*^9}},
 CellLabel->
  "In[592]:=",ExpressionUUID->"d721ed0f-dbca-4852-8c33-5713c6ced193"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "Ctotal", "]"}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Baseline", " ", 
    RowBox[{"weights", ":", 
     RowBox[{"treat", " ", "all", " ", "layers", " ", "equally"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wEFT", "=", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wCosmo", "=", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wObs", "=", "1.0"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ctotal", "[", "ng_", "]"}], ":=", 
    RowBox[{
     RowBox[{"wEFT", "*", 
      RowBox[{"CEFT", "[", "ng", "]"}]}], "+", 
     RowBox[{"wCosmo", "*", 
      RowBox[{"Ccosmo", "[", "ng", "]"}]}], "+", 
     RowBox[{"wObs", "*", 
      RowBox[{"Cobs", "[", "ng", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Visualize", " ", "combined", " ", "cost", " ", "in", " ", "the", " ", 
    "band"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"baselinePlot", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Ctotal", "[", "ng", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ng", ",", "ngMin", ",", "ngMax"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<ng\>\"", ",", "\"\<Ctotal\>\""}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Combined closure functional (wEFT=wCosmo=wObs=1)\>\""}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"baselinePlot", "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "minimizing", " ", "ng", " ", "in", " ", "this", " ", 
    "band"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baselineMin", "=", 
   RowBox[{"NMinimize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ctotal", "[", "ng", "]"}], ",", 
       RowBox[{"ngMin", "<=", "ng", "<=", "ngMax"}]}], "}"}], ",", "ng"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ngStarBase", "=", 
   RowBox[{"ng", "/.", " ", 
    RowBox[{"Last", "[", "baselineMin", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"costStarBase", "=", 
    RowBox[{"First", "[", "baselineMin", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"ngStarBase", ",", "costStarBase"}], "}"}], "\n"}], "Input",
 CellChangeTimes->{{3.975728370821844*^9, 3.975728370823983*^9}},
