Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Genesis", " ", "Closure", " ", "Toy", " ", 
     RowBox[{"Model", ":", 
      RowBox[{
       RowBox[{"Fresh", " ", "Notebook"}], "==="}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Central", " ", "guess", " ", "and", " ", "scan", " ", "range", " ", "for",
     " ", "ng"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CosmoMisfit", "[", 
      RowBox[{"ng_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"ng", "-", "1.15414"}], ")"}], "^", "2"}], "+", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "\n", ";", "\n", 
   RowBox[{
    RowBox[{"ngRange", "=", "0.0005"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"+", 
       RowBox[{"/", 
        RowBox[{"-", "5"}]}]}], "e"}], "-", 
     RowBox[{"4", " ", "around", " ", "center"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ngMin", "=", 
     RowBox[{"ngCenter", "-", "ngRange"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ngMax", "=", 
     RowBox[{"ngCenter", "+", "ngRange"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Map", " ", "ng"}], "->", "alpha"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "alphaOf", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"alphaOf", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ng", "^", "2"}], "-", "1"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.975728345862975*^9, 3.975728345864978*^9}, {
  3.97573014268255*^9, 
  3.975730164714346*^9}},ExpressionUUID->"9bdfebd9-357f-4582-93f6-\
96634fde55ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Layer", "-", 
    RowBox[{"preferred", " ", "ng", " ", "values"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ngEFTTarget", "=", "1.1539800017415"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"EFT", " ", "layer", " ", "prefers", " ", "this"}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"ngCosmoTarget", "=", "1.15428"}], ";"}], "               ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"cosmology", "/", "closure"}], " ", "layer"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ngObsTarget", "=", "1.154307344136304"}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{"observer", "-", 
     RowBox[{"window", " ", "layer"}]}], "*)"}], "\n"}]}]], "Input",
