Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Final", " ", 
    RowBox[{"Audit", ":", 
     RowBox[{
     "Asymptotic", " ", "Convergence", " ", "and", " ", "Observable", " ", 
      "Decay"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Constants", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauRelax", "=", "20"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"20", " ", "Gyr", " ", "Relaxation", " ", "Horizon"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Grover", " ", "Potential", " ", "Function", " ", "with", " ", "Scale", " ",
      "Parameter", " ", "s"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"s", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "+", "0.1"}], ")"}]}], ")"}], "+", 
      RowBox[{"R", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "+", "s"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Relative", " ", "Difference", " ", 
     RowBox[{"(", 
      RowBox[{"Asymptotic", " ", "Bound"}], ")"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Proving", "|", 
      RowBox[{"Vi", "-", "Vj"}], "|", " ", 
      RowBox[{"/", "Vi"}]}], "->", 
     RowBox[{
      RowBox[{"0", " ", "as", " ", "r"}], "->", "Infinity"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RelativeDiff", "[", 
      RowBox[{"r_", ",", "s1_", ",", "s2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"r", ",", "s1"}], "]"}], "-", 
        RowBox[{"V", "[", 
         RowBox[{"r", ",", "s2"}], "]"}]}], "]"}], "/", 
      RowBox[{"V", "[", 
       RowBox[{"r", ",", "s1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Apparent", " ", "Dark", " ", "Matter", " ", "Fraction", " ", 
     "fDM", 
     RowBox[{"(", 
      RowBox[{"r", ",", "t"}], ")"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Metric", " ", "Memory", " ", "decays", " ", "over", " ", "time", " ", 
     "t", " ", "and", " ", "distance", " ", "r"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fDM", "[", 
      RowBox[{"r_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "*", 
        RowBox[{"Log", "[", 
         RowBox[{"r", "+", "1"}], "]"}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "tauRelax"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", "r"}], "+", "0.1"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Visualization"}]}], " ", "1"}], ":", 
     RowBox[{
      RowBox[{"The", " ", "Vanishing", " ", 
       RowBox[{"Bound", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"RelativeDiff", "[", 
         RowBox[{"r", ",", "0.05", ",", "s2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s2", ",", 
          RowBox[{"{", 
           RowBox[{"1.0", ",", "10.0"}], "}"}]}], "}"}]}], "]"}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"r", ",", "0.1", ",", "500"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Cyan", ",", "Magenta"}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
