Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Derived Potential Form (r -> Infinity): \"\>", "\[InvisibleSpace]", 
   RowBox[{"InverseFourierTransform", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Abs", "[", "kx", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Abs", "[", "ky", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Abs", "[", "kz", "]"}], "2"], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"Abs", "[", "kx", "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"Abs", "[", "ky", "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"Abs", "[", "kz", "]"}], "2"]}], ")"}], "2"], " ", 
        "R_inv"}]}]], ",", 
     RowBox[{"{", 
      RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}],
  SequenceForm["Derived Potential Form (r -> Infinity): ", 
   InverseFourierTransform[(Abs[$CellContext`kx]^2 + Abs[$CellContext`ky]^2 + 
     Abs[$CellContext`kz]^2 + (Abs[$CellContext`kx]^2 + 
        Abs[$CellContext`ky]^2 + Abs[$CellContext`kz]^2)^2 
      Pattern[$CellContext`R, 
        Blank[$CellContext`inv]])^(-1), {$CellContext`kx, $CellContext`ky, \
$CellContext`kz}, {$CellContext`x, $CellContext`y, $CellContext`z}]],
