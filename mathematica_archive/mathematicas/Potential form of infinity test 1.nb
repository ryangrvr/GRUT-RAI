Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Phase", " ", "1"}], ":", 
    RowBox[{
     RowBox[{
     "Deriving", " ", "the", " ", "Logarithmic", " ", "Tail", " ", "from", " ",
       "the", " ", "Non"}], "-", 
     RowBox[{"local", " ", "Anomaly"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "the", " ", "non"}], "-", 
     RowBox[{
     "local", " ", "operator", " ", "kernel", " ", "in", " ", "momentum", " ",
       "space", " ", "for", " ", "the", " ", 
      RowBox[{"1", "/", 
       RowBox[{"k", "^", "4"}]}], " ", "limit"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"This", " ", "represents", " ", "the", " ", "anomaly"}], "-", 
     RowBox[{
     "induced", " ", "correction", " ", "to", " ", "the", " ", "graviton", " ",
       "propagator"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"kernel", "[", 
      RowBox[{"k_", ",", "R_"}], "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], "+", 
        RowBox[{"R", "*", 
         RowBox[{"k", "^", "4"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Fourier", " ", "Transform", " ", "the", " ", "kernel", " ", "to", " ", 
     "find", " ", "the", " ", "spatial", " ", "potential", " ", "V", 
     RowBox[{"(", "r", ")"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"For", " ", "a", " ", "point", " ", "source", " ", "delta", 
      RowBox[{"(", "r", ")"}]}], ",", 
     RowBox[{"V", 
      RowBox[{"(", "r", ")"}], " ", "is", " ", "the", " ", 
      RowBox[{"Green", "'"}], "s", " ", "function", " ", "of", " ", "the", " ",
       "modified", " ", "Poisson", " ", "eqn"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"potentialDerivation", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"InverseFourierTransform", "[", 
       RowBox[{
        RowBox[{"kernel", "[", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"{", 
            RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}], "]"}], ",", 
          "R_inv"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Outputting", " ", "the", " ", "functional", " ", "form", " ", "shows", " ",
      "the", " ", "emergence", " ", "of", " ", "the", " ", "Log", 
     RowBox[{"(", "r", ")"}], " ", "term"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Derived Potential Form (r -> Infinity): \>\"", ",", 
      "potentialDerivation"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Phase", " ", "2"}], ":", 
     RowBox[{"Stochastic", " ", "Langevin", " ", "Relaxation", " ", 
      RowBox[{"(", 
       RowBox[{
       "Deriving", " ", "the", " ", "20", " ", "Gyr", " ", "Horizon"}], 
       ")"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Modeling", " ", "the", " ", "metric", " ", "memory", " ", "decay", " ", 
     "as", " ", "a", " ", "dissipative", " ", "system"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaValue", "=", 
     RowBox[{"1", "/", "20"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Dissipation", " ", "derived", " ", "from", " ", 
     RowBox[{"Im", "[", 
      RowBox[{"Self", "-", "Energy"}], "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"stochasticEq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "gammaValue"}], "*", 
        RowBox[{"x", "[", "t", "]"}]}], "+", 
       RowBox[{"WhiteNoiseProcess", "[", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Solve", " ", "for", " ", "the", " ", "mean", " ", "relaxation", " ", 
     "of", " ", "a", " ", "metric", " ", "perturbation", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"e", ".", "g", "."}], ",", 
       RowBox[{"a", " ", "cluster", " ", "collision"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"SolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"m", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"-", "gammaValue"}], "*", 
           RowBox[{"m", "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"m", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
       RowBox[{"m", "[", "t", "]"}], ",", "t"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Plotting", " ", "the", " ", "Microscopic", " ", "Decay", " ", "Law"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"relaxationPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{"sol", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "60"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time (Gyr)\>\"", 
          ",", "\"\<Metric Memory Amplitude\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Derivation: Exponential Relaxation from Stochastic Gravity\
\>\""}], ",", 
       RowBox[{"Background", "->", "Black"}], ",", 
       RowBox[{"FrameStyle", "->", "White"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "relaxationPlot", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9755081421070347`*^9, 3.975508142109075*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"b9e83c8c-6be4-4665-b874-98b2aee2c3a5"],

