Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Genesis", " ", "Closure", " ", 
     RowBox[{"Scan", ":", 
      RowBox[{
       RowBox[{
        RowBox[{"Toy", " ", "Three"}], "-", 
        RowBox[{"Layer", " ", "Model"}]}], "==="}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Scan", " ", "band", " ", "around", " ", "current", " ", "closure", " ", 
    "value"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ngCenter", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ngRange", "=", "0.0005"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ngMin", "=", 
     RowBox[{"ngCenter", "-", "ngRange"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ngMax", "=", 
     RowBox[{"ngCenter", "+", "ngRange"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Map", " ", "ng"}], "->", "alpha"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"alphaOf", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ng", "^", "2"}], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Layer", "-", 
     RowBox[{
     "preferred", " ", "values", " ", "from", " ", "earlier", " ", 
      "exploration"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ngEFTTarget", "=", "1.1539800017415"}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"EFT", "-", 
     RowBox[{"preferred", " ", "ng"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ngCosmoTarget", "=", "1.15428"}], ";"}], "               ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"cosmology", "/", "closure"}], " ", "value"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ngObsTarget", "=", "1.154307344136304"}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{"observer", "-", 
     RowBox[{"window", " ", "preferred", " ", "ng"}]}], "*)"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.9757268880651608`*^9, 3.975726888067396*^9}},
 CellLabel->
  "In[435]:=",ExpressionUUID->"69113336-7acf-4712-b88f-7a03d840398d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Simple", " ", "quadratic", " ", "penalties", " ", "around", " ", "each", " ", 
    RowBox[{"layer", "'"}], "s", " ", "target"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CEFT", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ng", "-", "ngEFTTarget"}], ")"}], "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Ccosmo", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ng", "-", "ngCosmoTarget"}], ")"}], "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Cobs", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ng", "-", "ngObsTarget"}], ")"}], "^", "2"}]}], ";"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.975726900552784*^9, 3.97572690055486*^9}},
 CellLabel->
  "In[443]:=",ExpressionUUID->"e3b53759-ae9e-4092-a9f3-cf501f858569"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initial", " ", 
    RowBox[{"weights", ":", 
     RowBox[{
     "treat", " ", "all", " ", "three", " ", "layers", " ", "equally"}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"wEFT", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wCosmo", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wObs", "=", "1.0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ctotal", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"wEFT", "*", 
       RowBox[{"CEFT", "[", "ng", "]"}]}], "+", 
      RowBox[{"wCosmo", "*", 
       RowBox[{"Ccosmo", "[", "ng", "]"}]}], "+", 
      RowBox[{"wObs", "*", 
       RowBox[{"Cobs", "[", "ng", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Visualize", " ", "total", " ", "cost"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"baselinePlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Ctotal", "[", "ng", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ng", ",", "ngMin", ",", "ngMax"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<ng\>\"", ",", "\"\<Ctotal\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Combined closure functional (wEFT=wCosmo=wObs=1)\>\""}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", "baselinePlot", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Find", " ", "minimizing", " ", "ng", " ", "in", " ", "this", " ", 
     "band"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"baselineMin", "=", 
     RowBox[{"NMinimize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Ctotal", "[", "ng", "]"}], ",", 
         RowBox[{"ngMin", "<=", "ng", "<=", "ngMax"}]}], "}"}], ",", "ng"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ngStarBase", "=", 
     RowBox[{"ng", "/.", " ", 
      RowBox[{"Last", "[", "baselineMin", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"costStarBase", "=", 
     RowBox[{"First", "[", "baselineMin", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"ngStarBase", ",", "costStarBase"}], "}"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9757269071129847`*^9, 3.975726907115176*^9}},
 CellLabel->
