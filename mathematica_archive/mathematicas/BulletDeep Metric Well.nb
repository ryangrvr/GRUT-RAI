Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Deep", " ", 
    RowBox[{"Audit", ":", 
     RowBox[{
     "Scaling", " ", "the", " ", "Anomaly", " ", "to", " ", "Hubble", " ", 
      "Levels"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"offVal", "=", "6.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"softening", "=", "0.01"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Deepening", " ", "the", " ", "well", " ", "from", " ", "0.1", " ", "to", 
     " ", "0.01"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LensingIntensity", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rGas", ",", "rA", ",", "rB"}], "}"}], ",", 
       RowBox[{
        RowBox[{"rGas", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rA", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rB", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Total", " ", "Force", " ", "Magnitude"}], "*)"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1.0", "/", 
            RowBox[{"rGas", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "*", 
              RowBox[{"Sqrt", "[", "a0", "]"}]}], ")"}], "/", "rGas"}]}], 
          ")"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1.2", "/", 
            RowBox[{"rA", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "/", "rA"}]}], 
          ")"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1.2", "/", 
            RowBox[{"rB", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"R", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "/", "rB"}]}], 
          ")"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Calculate", " ", "the", " ", "New", " ", "Factors"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gasPeak", "=", 
     RowBox[{"LensingIntensity", "[", 
      RowBox[{"0", ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ghostPeak", "=", 
     RowBox[{"LensingIntensity", "[", 
      RowBox[{"offVal", ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dmFactor", "=", 
     RowBox[{"ghostPeak", "/", 
      RowBox[{"(", 
       RowBox[{"1.2", "/", "softening"}], ")"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Ratio", " ", "relative", " ", "to", " ", "expected", " ", "baryonic", " ",
      "pull"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<--- Deep Well Audit ---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Softening Parameter: \>\"", ",", "softening"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Baryonic (Gas) Intensity: \>\"", ",", "gasPeak"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ghost (Metric Memory) Intensity: \>\"", ",", "ghostPeak"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Calculated 'Dark Matter' Factor: \>\"", ",", "dmFactor"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<-----------------------\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Visualization", " ", "with", " ", "high", " ", "contrast"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"LensingIntensity", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<Magma\>\""}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Deep Metric Well: R-Invariant Lensing at 0.01 Scale\>\""}]}],
     "]"}]}]}]], "Input",
