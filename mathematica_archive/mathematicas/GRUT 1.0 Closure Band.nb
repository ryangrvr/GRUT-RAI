Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Sum", " ", "baryonic", " ", "components", " ", "in", " ", "quadrature", " ", 
    RowBox[{"(", 
     RowBox[{"Newtonian", " ", "Base"}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"vNewtonian", "[", "pt_Association", "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pt", "[", "\"\<vGas\>\"", "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"pt", "[", "\"\<vDisk\>\"", "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"pt", "[", "\"\<vBulge\>\"", "]"}], "^", "2"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Predict", " ", "velocity", " ", "based", " ", "on", " ", "ng", " ", 
     RowBox[{"(", 
      RowBox[{"GRUT", " ", "Boost"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"vPredict", "[", 
      RowBox[{"pt_Association", ",", "ng_"}], "]"}], ":=", 
     RowBox[{"ng", "*", 
      RowBox[{"vNewtonian", "[", "pt", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Calculate", " ", "chi"}], "-", 
     RowBox[{"square", " ", "for", " ", "a", " ", "single", " ", "galaxy"}]}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"chiSqGal", "[", 
      RowBox[{"galData_List", ",", "ng_"}], "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"pt", "[", "\"\<vObs\>\"", "]"}], "-", 
            RowBox[{"vPredict", "[", 
             RowBox[{"pt", ",", "ng"}], "]"}]}], ")"}], "^", "2"}], "/", 
         RowBox[{
          RowBox[{"pt", "[", "\"\<errV\>\"", "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"pt", ",", "galData"}], "}"}]}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.975872143626346*^9, 3.975872143628813*^9}},
 CellLabel->
  "In[889]:=",ExpressionUUID->"425e4ec6-8855-4e0a-be09-f535863e9b79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"EFT", " ", 
    RowBox[{"Penalty", ":", 
     RowBox[{
      RowBox[{"Steep", " ", "wall", " ", "if", " ", 
       RowBox[{"ng", "^", "2"}]}], ">", "2.0"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pEFT", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"10", "^", "6"}], "*", 
      RowBox[{"UnitStep", "[", 
       RowBox[{
        RowBox[{"ng", "^", "2"}], "-", "2.0"}], "]"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ng", "^", "2"}], "-", "2.0"}], ")"}], "^", "2"}]}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Local", " ", 
     RowBox[{"Penalty", ":", 
      RowBox[{
       RowBox[{"Anchors", " ", "high"}], "-", 
       RowBox[{
        RowBox[{"freq", "/", "local"}], " ", "gravity", " ", "to", " ", "G", " ", 
        RowBox[{"(", 
         RowBox[{"ng", "->", "1"}], ")"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pLoc", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"10", "^", "5"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ng", "^", "2"}], "-", "1"}], ")"}], "^", "2"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "Cost", " ", "Functional"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"totalCost", "[", 
      RowBox[{"ng_", ",", "weights_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wEFT", ",", "wLoc", ",", "wCos"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"wEFT", ",", "wLoc", ",", "wCos"}], "}"}], "=", "weights"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wEFT", "*", 
          RowBox[{"pEFT", "[", "ng", "]"}]}], "+", 
         RowBox[{"wLoc", "*", 
          RowBox[{"pLoc", "[", "ng", "]"}]}], "+", 
         RowBox[{"wCos", "*", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"chiSqGal", "[", 
              RowBox[{"#", ",", "ng"}], "]"}], "&"}], "/@", 
            RowBox[{"Values", "[", "galaxyStore", "]"}]}], "]"}]}]}]}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.97587215774128*^9, 3.9758721577433443`*^9}},
 CellLabel->
  "In[892]:=",ExpressionUUID->"1dcc6424-eeab-4053-b1da-e1557f0042da"],

