Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Run", " ", "the", " ", "Minimizer", " ", "for", " ", "the", " ",
     "Baseline", " ", "Scenario"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"baselineFit", "=", 
     RowBox[{"FindMinimum", "[", 
      RowBox[{
       RowBox[{"totalCost", "[", 
        RowBox[{"n", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1.15"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Generate", " ", "the", " ", "Likelihood", " ", "Surface", " ",
      "for", " ", "Plotting"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"totalCost", "[", 
          RowBox[{"n", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1.0", ",", "1.3", ",", "0.005"}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Output", " ", "Results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Calculated Best Fit ng: \>\"", ",", 
      RowBox[{"n", "/.", " ", 
       RowBox[{"baselineFit", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theoretical alpha-lock ng: \>\"", ",", "ngTheoretical"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Delta: \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "/.", " ", 
         RowBox[{"baselineFit", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "-", "ngTheoretical"}]}], 
     "]"}], ";"}]}]}]], "Input",
