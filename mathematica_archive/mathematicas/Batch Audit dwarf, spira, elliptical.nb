Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", 
    RowBox[{"Protocol", ":", 
     RowBox[{"Multi", "-", 
      RowBox[{"Scale", " ", "Batch", " ", "Audit", " ", 
       RowBox[{"(", 
        RowBox[{"Dwarf", ",", "Spiral", ",", "Elliptical"}], ")"}]}]}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Global", " ", "R"}], "-", "invariant"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Grover", " ", "Velocity", " ", "Function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vGrover", "[", 
      RowBox[{"r_", ",", "s_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Max", "[", 
       RowBox[{"0", ",", 
        RowBox[{"r", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], "*", 
            RowBox[{"s", "/", 
             RowBox[{"r", "^", "3"}]}]}], "+", 
           RowBox[{"R", "/", 
            RowBox[{"(", 
             RowBox[{"r", "+", "s"}], ")"}]}]}], ")"}]}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Galaxy", " ", 
     RowBox[{"Parameters", ":", 
      RowBox[{"{", 
       RowBox[{"Name", ",", 
        RowBox[{"ScaleParameter", " ", "s"}], ",", "PlotColor"}], "}"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"galaxyBatch", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Dwarf (High Memory Lag)\>\"", ",", "0.2", ",", "Cyan"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Spiral (Standard Audit)\>\"", ",", "1.5", ",", 
         "Orange"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Elliptical (Massive Buffer)\>\"", ",", "5.0", ",", 
         "Magenta"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Batch"}]}], " ", 
      RowBox[{"Visualization", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"batchPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"vGrover", "[", 
           RowBox[{"r", ",", 
            RowBox[{"g", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"g", ",", "galaxyBatch"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0.1", ",", "60"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.5"}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"Thickness", "[", "0.008", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"g", ",", "galaxyBatch"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Radius (kpc)\>\"", 
          ",", "\"\<Circular Velocity (Normalized)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Grover Batch Audit: Universality of R = 1.15428\>\"", ",",
           "14"}], "]"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"SwatchLegend", "[", 
         RowBox[{
          RowBox[{"galaxyBatch", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", 
          RowBox[{"galaxyBatch", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"Background", "->", "Black"}], ",", 
       RowBox[{"FrameStyle", "->", "White"}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"GridLinesStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Dashed"}], "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "batchPlot", "]"}], ";"}]}]}]], "Input",
