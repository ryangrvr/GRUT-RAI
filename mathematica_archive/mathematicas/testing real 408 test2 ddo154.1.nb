        RowBox[{
         RowBox[{"ng", "^", "2"}], "-", "1"}]}], ",", "modelCurve", ",", 
       "dataCurve", ",", "vModel", ",", "vObs", ",", "sigma", ",", "chi2"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"modelCurve", "=", 
       RowBox[{"ddo154Model", "[", "alpha", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dataCurve", "=", "ddo154Data"}], ";", "\[IndentingNewLine]", 
      RowBox[{"vModel", "=", 
       RowBox[{"modelCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vObs", "=", 
