      RowBox[{"sigma", "=", 
       RowBox[{"dataCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"chi2", "=", 
