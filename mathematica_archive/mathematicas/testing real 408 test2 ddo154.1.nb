Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "List", " ", "of", " ", "galaxies", " ", "you", " ", "want", " ", "in", " ",
     "the", " ", "closure"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"galaxyList", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<DDO154\>\"", ",", "\"\<Galaxy2\>\"", 
       ",", "\"\<Galaxy3\>\""}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "modelCurve", ",", "dataCurve", ",", "GalaxyMisfit", ",", 
      "CosmoMisfit"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"modelCurve", "[", 
      RowBox[{"galID", ",", "alpha"}], "]"}], " ", "and", " ", 
     RowBox[{"dataCurve", "[", "galID", "]"}], " ", "are", " ", "assumed", " ",
      "already", " ", "defined"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GalaxyMisfit", "[", 
      RowBox[{"galID_", ",", 
       RowBox[{"ng_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"alpha", "=", 
          RowBox[{
           RowBox[{"ng", "^", "2"}], "-", "1"}]}], ",", "mCurve", ",", 
         "dCurve", ",", "vModel", ",", "vObs", ",", "sigma"}], "}"}], ",", 
       RowBox[{
        RowBox[{"mCurve", "=", 
         RowBox[{"modelCurve", "[", 
          RowBox[{"galID", ",", "alpha"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dCurve", "=", 
         RowBox[{"dataCurve", "[", "galID", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vModel", "=", 
         RowBox[{"mCurve", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vObs", "=", 
         RowBox[{"dCurve", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sigma", "=", 
         RowBox[{"dCurve", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"adjust", " ", "if", " ", "no", " ", "errors"}], "*)"}], 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"vModel", "-", "vObs"}], ")"}], "/", "sigma"}], ")"}], "^",
           "2"}], "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CosmoMisfit", "[", 
      RowBox[{"ng_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GalaxyMisfit", "[", 
         RowBox[{"#", ",", "ng"}], "]"}], "&"}], "/@", "galaxyList"}], 
      "]"}]}], ";"}], "\n"}]}]], "Input",
