Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "GalaxyMisfit", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GalaxyMisfit", "[", 
    RowBox[{"galID_", ",", 
     RowBox[{"ng_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"alpha", "=", 
        RowBox[{
         RowBox[{"ng", "^", "2"}], "-", "1"}]}], ",", "mCurve", ",", "dCurve",
        ",", "vModel", ",", "vObs", ",", "sigma", ",", "chi2"}], "}"}], ",", 
     RowBox[{
      RowBox[{"mCurve", "=", 
       RowBox[{"modelCurve", "[", 
        RowBox[{"galID", ",", "alpha"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"dCurve", "=", 
       RowBox[{"dataCurve", "[", "galID", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vModel", "=", 
       RowBox[{"mCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vObs", "=", 
       RowBox[{"dCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "with", " ", "uncertainties", " ", "in", " ", "column", " ", "3"}], ";", 
        RowBox[{"adjust", " ", "if", " ", "you", " ", 
         RowBox[{"don", "'"}], "t", " ", "have", " ", "sigma"}]}], "*)"}], 
      RowBox[{"sigma", "=", 
       RowBox[{"dCurve", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"chi2", "=", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"vModel", "-", "vObs"}], ")"}], "/", "sigma"}], ")"}], "^",
          "2"}], "]"}]}], ";", "\[IndentingNewLine]", "chi2"}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.975729540525321*^9, 3.975729540527401*^9}},
 CellLabel->
  "In[666]:=",ExpressionUUID->"c641885c-2539-4a40-a80b-ec3d32c9fbe4"],

