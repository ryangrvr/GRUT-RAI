      RowBox[{"Density", " ", "Correction"}], "+", 
      RowBox[{"Asymptotic", " ", "Saturation"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";", 
    RowBox[{"gamma", "=", "0.45"}], ";", 
    RowBox[{"sigmaRef", "=", "500"}], ";", 
    RowBox[{"sMax", "=", "22.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kappa", "=", 
     RowBox[{"0.8", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"10", "^", "8.5"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "3"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Refined", " ", "s"}], "-", 
     RowBox[{"Law", " ", "with", " ", "Saturation"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sScaling", "[", 
      RowBox[{"mb_", ",", "sigmaB_"}], "]"}], ":=", 
     RowBox[{"kappa", "*", 
      RowBox[{"mb", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "3"}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"sigmaRef", "/", "sigmaB"}], ")"}], "^", "gamma"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sFinal", "[", 
      RowBox[{"mb_", ",", "sigmaB_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"sScaling", "[", 
         RowBox[{"mb", ",", "sigmaB"}], "]"}], "*", "sMax"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"sScaling", "[", 
         RowBox[{"mb", ",", "sigmaB"}], "]"}], "+", "sMax"}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Census", " ", 
     RowBox[{"Data", ":", 
      RowBox[{"{", 
       RowBox[{"LogMb", ",", "SigmaB", ",", "r", ",", "Vobs", ",", "Vbar"}], 
       "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"census", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8.2", ",", "15", ",", "2.5", ",", "82", ",", "12"}], "}"}], ",", 
       RowBox[{"(*", "Dwarf_A", "*)"}], 
       RowBox[{"{", 
        RowBox[{"11.5", ",", "2000", ",", "30.0", ",", "335", ",", "260"}], 
        "}"}], ",", 
       RowBox[{"(*", "Elliptical_A", "*)"}], 
       RowBox[{"{", 
        RowBox[{"12.5", ",", "1200", ",", "100.0", ",", "380", ",", "200"}], 
        "}"}]}], " ", 
      RowBox[{"(*", "Giant_A", "*)"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{"sFinal", "[", 
        RowBox[{
         RowBox[{"10", "^", "logMb"}], ",", "sigmaB"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vAnomSq", "=", 
       RowBox[{
        RowBox[{"220", "^", "2"}], "*", "r", "*", 
        RowBox[{"(", 
         RowBox[{"R", "/", 
          RowBox[{"(", 
           RowBox[{"r", "+", "s"}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vPred", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"vBar", "^", "2"}], "+", "vAnomSq"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"logMb", ",", 
        RowBox[{"\"\<Residual\>\"", "->", 
         RowBox[{"vObs", "-", "vPred"}]}]}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"logMb", ",", "sigmaB", ",", "r", ",", "vObs", ",", "vBar"}], 
       "}"}], "->", "census"}]}], "]"}]}]}]], "Input",
