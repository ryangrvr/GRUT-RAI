Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"EFT", "-", 
     RowBox[{"emphasized", " ", "scan"}]}], "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"wEFT", "=", "3.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wCosmo", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wObs", "=", "1.0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ctotal", "[", "ng_", "]"}], ":=", 
     RowBox[{
      RowBox[{"wEFT", "*", 
       RowBox[{"CEFT", "[", "ng", "]"}]}], "+", 
      RowBox[{"wCosmo", "*", 
       RowBox[{"Ccosmo", "[", "ng", "]"}]}], "+", 
      RowBox[{"wObs", "*", 
