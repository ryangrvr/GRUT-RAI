Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Grover", " ", 
    RowBox[{"Protocol", ":", 
     RowBox[{"Plasma", "-", 
      RowBox[{"Phase", " ", "Structural", " ", "Refinement"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RUniv", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alpha", "=", "0.5"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Coupling", " ", "to", " ", "entropy"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"TRef", "=", "0.1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Galactic", " ", "baseline", " ", "in", " ", "keV"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Thermodynamic", " ", "Boost", " ", "Function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Boost", "[", 
      RowBox[{"T_", ",", "fgas_"}], "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"alpha", "*", 
       RowBox[{"(", 
        RowBox[{"T", "/", "TRef"}], ")"}], "*", "fgas"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Effective", " ", "Potential", " ", "Strength"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"REff", "[", 
      RowBox[{"T_", ",", "fgas_"}], "]"}], ":=", 
     RowBox[{"RUniv", "*", 
      RowBox[{"Boost", "[", 
       RowBox[{"T", ",", "fgas"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Comparative", " ", "Test"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Spiral R_eff: \>\"", ",", 
      RowBox[{"REff", "[", 
       RowBox[{"0.1", ",", "0.15"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Cluster R_eff: \>\"", ",", 
      RowBox[{"REff", "[", 
       RowBox[{"10.0", ",", "0.85"}], "]"}]}], "]"}], ";"}]}]}]], "Input",
