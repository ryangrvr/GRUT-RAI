Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Sensitivity", " ", "of", " ", "ng", " ", "to", " ", "Stellar", " ", 
     "Mass"}], "-", "to", "-", 
    RowBox[{"Light", " ", "Ratio", " ", 
     RowBox[{"(", "Upsilon", ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sensitivityTable", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "bestNg", "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "Adjust", " ", "vDisk", " ", "by", " ", "a", " ", "factor", " ", 
           "of", " ", 
           RowBox[{"Sqrt", "[", "Upsilon", "]"}]}], "*)"}], 
         RowBox[{
          RowBox[{
           RowBox[{"vPredictAdj", "[", 
            RowBox[{"pt_", ",", "ng_"}], "]"}], ":=", 
           RowBox[{"ng", "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"pt", "[", "\"\<vGas\>\"", "]"}], "^", "2"}], "+", 
              RowBox[{"ups", "*", 
               RowBox[{
                RowBox[{"pt", "[", "\"\<vDisk\>\"", "]"}], "^", "2"}]}], "+", 
              
              RowBox[{
               RowBox[{"pt", "[", "\"\<vBulge\>\"", "]"}], "^", "2"}]}], 
             "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Find", " ", "best", " ", "ng", " ", "for", " ", "this", " ", 
            "specific", " ", "Upsilon"}], "*)"}], 
          RowBox[{
           RowBox[{"tempCost", "[", "ng_", "]"}], ":=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"pt", "[", "\"\<vObs\>\"", "]"}], "-", 
                  RowBox[{"vPredictAdj", "[", 
                   RowBox[{"pt", ",", "ng"}], "]"}]}], ")"}], "^", "2"}], "/", 
               RowBox[{
                RowBox[{"pt", "[", "\"\<errV\>\"", "]"}], "^", "2"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"pt", ",", 
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"Values", "[", "galaxyStore", "]"}], ",", "1"}], 
                 "]"}]}], "}"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bestNg", "=", 
           RowBox[{"n", "/.", " ", 
            RowBox[{"Last", "[", 
             RowBox[{"FindMinimum", "[", 
              RowBox[{
               RowBox[{"tempCost", "[", "n", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"n", ",", "1.15"}], "}"}]}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
