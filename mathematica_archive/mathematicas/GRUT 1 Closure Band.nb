Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "STATISTICAL"}]}], " ", 
     RowBox[{"VERIFICATION", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"verifyClosure", "[", 
      RowBox[{"fitValue_", ",", "theoreticalValue_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"delta", ",", "sigmaTotal", ",", "dF", ",", "chiSqRed"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"delta", "=", 
         RowBox[{"fitValue", "-", "theoreticalValue"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Degrees", " ", "of", " ", "Freedom"}], "=", 
          RowBox[{
           RowBox[{"Total", " ", "Data", " ", "Points"}], "-", 
           RowBox[{"1", " ", 
            RowBox[{"(", 
             RowBox[{"the", " ", "single", " ", "parameter", " ", "ng"}], 
             ")"}]}]}]}], "*)"}], 
        RowBox[{"dF", "=", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Length", "/@", 
            RowBox[{"Values", "[", "galaxyStore", "]"}]}], "]"}], "-", 
          "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Minimum", " ", "Cost", " ", "at", " ", "the", " ", "fit", " ", 
          "point"}], "*)"}], 
        RowBox[{"chiSqRed", "=", 
         RowBox[{
          RowBox[{"baselineFit", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", "dF"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<--- CLOSURE ANALYSIS ---\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Empirical ng (Data): \>\"", ",", "fitValue"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Theoretical ng (Alpha-Lock): \>\"", ",", 
          "theoreticalValue"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Absolute Delta: \>\"", ",", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"delta", ",", 
            RowBox[{"{", 
             RowBox[{"Infinity", ",", "6"}], "}"}]}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Relative Error: \>\"", ",", 
          RowBox[{"100", "*", 
           RowBox[{"Abs", "[", 
            RowBox[{"delta", "/", "theoreticalValue"}], "]"}]}], 
          ",", "\"\<%\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Reduced Chi-Square: \>\"", ",", "chiSqRed"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "delta", "]"}], "<", "0.005"}], ",", 
          RowBox[{
          "Print", 
           "[", "\"\<RESULT: SUCCESS. Empirical fit is within the Theoretical \
Band.\>\"", "]"}], ",", 
          RowBox[{
          "Print", 
           "[", "\"\<RESULT: MARGINAL. Inspect individual galaxy residuals.\>\
\"", "]"}]}], "]"}], ";"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Execute", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"verifyClosure", "[", 
     RowBox[{
      RowBox[{"n", "/.", " ", 
       RowBox[{"baselineFit", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", "ngTheoretical"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.975872298609516*^9, 3.975872298612481*^9}},
 CellLabel->
  "In[900]:=",ExpressionUUID->"91742586-9dd4-41d7-af4a-ff329633c2d5"],

