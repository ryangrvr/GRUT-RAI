Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Phase", " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Numerical", " ", "Audit", " ", "of", " ", "the", " ", "Non"}], "-", 
     RowBox[{"local", " ", "Potential"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "the", " ", "Anomaly"}], "-", 
     RowBox[{"Corrected", " ", "Propagator", " ", "Kernel"}]}], "*)"}], "\n", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"k", "^", "2"}]}], " ", "is", " ", "standard", " ", 
      "gravity"}], ";", 
     RowBox[{
      RowBox[{"R", "*", 
       RowBox[{"k", "^", "4"}], " ", "is", " ", "the", " ", "IR", " ", 
       "non"}], "-", 
      RowBox[{"local", " ", "correction"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"kernel", "[", "k_", "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], "+", 
        RowBox[{"R", "*", 
         RowBox[{"k", "^", "4"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Use", " ", "a", " ", "1", "D", " ", "Radial", " ", "Numerical", " ", 
     "Transform", " ", "as", " ", "a", " ", "proxy", " ", "for", " ", "the", " ",
      "3", "D", " ", "potential"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "This", " ", "demonstrates", " ", "the", " ", "emergence", " ", "of", " ",
       "the", " ", "log"}], "-", 
     RowBox[{"tail", " ", "at", " ", "large", " ", "r"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"potentialNumeric", "[", 
      RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "/", "Pi"}], ")"}], "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"kernel", "[", "k", "]"}], "*", "k", "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", "*", "r"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"Method", "->", "\"\<ExtrapolatingOscillatory\>\""}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "Derived", " ", "Potential", " ", "to", " ", 
     "show", " ", "the", " ", "Metric", " ", "Grip"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"potentialPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"potentialNumeric", "[", "r", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0.5", ",", "50"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Cyan", ",", 
          RowBox[{"Thickness", "[", "0.008", "]"}]}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Radius (r)\>\"", ",", "\"\<Metric Potential V(r)\>\""}],
          "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Derivation: Emergence of Non-local Potential Tail\>\""}], ",", 
       RowBox[{"Background", "->", "Black"}], ",", 
       RowBox[{"FrameStyle", "->", "White"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Phase", " ", "2"}], ":", 
     RowBox[{"Deterministic", " ", "Relaxation", " ", 
      RowBox[{"(", 
       RowBox[{"The", " ", "Fading", " ", "Ghost"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaValue", "=", 
     RowBox[{"1", "/", "20"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1", "/", "Gyr"}], " ", "relaxation", " ", "rate"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"m", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"-", "gammaValue"}], "*", 
            RowBox[{"m", "[", "t", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"m", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
        RowBox[{"m", "[", "t", "]"}], ",", "t"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"relaxationPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"m", "[", "t", "]"}], "/.", " ", "sol"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "60"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time (Gyr)\>\"", 
          ",", "\"\<Metric Memory Amplitude\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Exponential Relaxation from Effective Damping\>\""}], ",", 
       
       RowBox[{"Background", "->", "Black"}], ",", 
       RowBox[{"FrameStyle", "->", "White"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{"potentialPlot", ",", "relaxationPlot"}], "}"}], "]"}], "]"}], 
    ";"}]}]}]], "Input",
