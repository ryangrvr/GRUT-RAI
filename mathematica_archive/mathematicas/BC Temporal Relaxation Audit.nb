Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"The", " ", "Vanguard", " ", 
    RowBox[{"Audit", ":", 
     RowBox[{"Metric", " ", "Relaxation", " ", "Time"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"offVal", "=", "6.0"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "Decay", " ", 
     RowBox[{"Function", ":", 
      RowBox[{
       RowBox[{
       "s", " ", "represents", " ", "cosmic", " ", "time", " ", "in", " ", 
        "Giga"}], "-", "years"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GhostDecay", "[", "s_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "intensity", "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "The", " ", "anomaly", " ", "residue", " ", "dissipates", " ", "as", " ", 
         RowBox[{"1", "/", "sqrt"}], 
         RowBox[{"(", "s", ")"}], " ", "based", " ", "on", " ", "heat", " ", 
         "kernel"}], "*)"}], 
       RowBox[{
        RowBox[{"intensity", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"R", "*", 
            RowBox[{"Sqrt", "[", "a0", "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"Sqrt", "[", "s", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", "intensity"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"GhostDecay", "[", "s", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0", ",", "20"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Cyan"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time (Gyr)\>\"", ",", "\"\<Ghost Intensity\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<The Erasure of Memory: Metric Relaxation (R=1.15428)\>\""}], 
     ",", 
     RowBox[{"Filling", "->", "Axis"}], ",", 
     RowBox[{"FillingStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Opacity", "[", "0.1", "]"}], ",", "Blue"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.975472419878953*^9, 3.97547241988102*^9}},
