Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"The", " ", "Vanguard", " ", 
    RowBox[{"Audit", ":", 
     RowBox[{"Metric", " ", "Shear", " ", "Vector", " ", "Field"}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"offVal", "=", "6.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"softening", "=", "0.1"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Gradient", " ", "of", " ", "the", " ", "Lensing", " ", "Potential", " ", 
     "represents", " ", "the", " ", "Shear", " ", "Flow"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Potential", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1.0", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], "+", 
        RowBox[{"(", 
         RowBox[{"R", "*", 
          RowBox[{"Log", "[", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"x", "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}], "]"}]}], 
         ")"}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1.2", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], "+", 
        RowBox[{"(", 
         RowBox[{"R", "*", 
          RowBox[{"Log", "[", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", "offVal"}], ")"}], "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}], "]"}]}], 
         ")"}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1.2", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}]}], "+", 
        RowBox[{"(", 
         RowBox[{"R", "*", 
          RowBox[{"Log", "[", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "+", "offVal"}], ")"}], "^", "2"}], "+", 
             RowBox[{"y", "^", "2"}], "+", "softening"}], "]"}], "]"}]}], 
         ")"}]}], ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"VectorPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{"Potential", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "7"}], ",", "7"}], "}"}], ",", 
     RowBox[{"VectorStyle", "->", "\"\<Arrowhead\>\""}], ",", 
     RowBox[{"VectorColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Metric Shear: The Momentum of Vacuum Memory \
(R=1.15428)\>\""}]}], "]"}]}]}]], "Input",
