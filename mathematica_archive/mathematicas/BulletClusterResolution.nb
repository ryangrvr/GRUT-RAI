Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{"Force", " ", "Global", " ", "Numerical", " ", "Values"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"R", "=", "1.15428"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"offVal", "=", "6.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "use", " ", "a", " ", "new", " ", "name", " ", "to", " ", 
     "avoid", " ", "symbolic", " ", "conflicts"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{
     "Define", " ", "a", " ", "Purely", " ", "Numerical", " ", "Force", " ", 
      "Function"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ghostForce", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rGas", ",", "rA", ",", "rB", ",", "fGas", ",", "fA", ",", "fB"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"rGas", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "0.1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rA", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "0.1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rB", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "offVal"}], ")"}], "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}], "+", "0.1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Newtonian", " ", 
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"r", "^", "2"}]}], ")"}]}], "+", 
          RowBox[{"Anomaly", " ", 
           RowBox[{"(", 
            RowBox[{"R", "/", "r"}], ")"}], " ", "terms"}]}], "*)"}], 
        RowBox[{"fGas", "=", 
         RowBox[{
          RowBox[{"1.0", "/", 
           RowBox[{"rGas", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"R", "*", 
             RowBox[{"Sqrt", "[", "a0", "]"}]}], ")"}], "/", "rGas"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fA", "=", 
         RowBox[{
          RowBox[{"1.2", "/", 
           RowBox[{"rA", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"R", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "/", "rA"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fB", "=", 
         RowBox[{
          RowBox[{"1.2", "/", 
           RowBox[{"rB", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"R", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.2", "*", "a0"}], "]"}]}], ")"}], "/", "rB"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fGas", "+", "fA", "+", "fB"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "3"}], ":", 
     RowBox[{"Plot", " ", "with", " ", "Absolute", " ", "Magnitude"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"ghostForce", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
     RowBox[{"PlotPoints", "->", "60"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Metric Memory: Ghost Lensing Resolved (R=1.15428)\>\""}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Distance (Lag)\>\"", ",", "\"\<y\>\""}], "}"}]}]}], 
    "]"}]}]}]], "Input",
